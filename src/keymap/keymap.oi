use json
use math

# rx's own actions. binds no keys, init.lua does
pub REQUEST :: r"""{
	"actions": [
		{"name": "detach", "kind": "client", "title": "Detach"},
		{"name": "session.choose", "kind": "client", "title": "choose session"},
		{"name": "session.new", "kind": "client", "title": "new session"},
		{"name": "session.warp", "kind": "client", "title": "warp to session"},
		{"name": "session.rename", "kind": "client", "title": "rename session"},
		{"name": "session.close", "kind": "client", "title": "close session", "args": {"type": "object", "properties": {"confirm": {"type": "boolean"}}}},
		{"name": "session.next", "kind": "client", "title": "next session"},
		{"name": "session.last", "kind": "client", "title": "last session"},
		{"name": "session.previous", "kind": "client", "title": "previous session"},
		{"name": "session.goto", "kind": "client", "title": "go to session", "args": {"type": "object", "properties": {"index": {"type": "integer"}}, "required": ["index"]}},
		{"name": "session.select", "kind": "client", "title": "select session", "args": {"type": "object", "properties": {"session_id": {"type": "string"}, "window_id": {"type": "string"}}, "required": ["session_id"]}},
		{"name": "pane.split", "kind": "client", "title": "split pane", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "down", "left", "up"]}, "command": {"type": "string"}}}},
		{"name": "pane.break", "kind": "client", "title": "break pane to tab"},
		{"name": "pane.mark", "kind": "client", "title": "mark pane"},
		{"name": "pane.join", "kind": "client", "title": "join marked pane", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "down", "left", "up"]}}}},
		{"name": "pane.rotate", "kind": "client", "title": "rotate panes", "args": {"type": "object", "properties": {"direction": {"enum": ["down", "up"]}}}},
		{"name": "pane.edit", "kind": "client", "title": "edit scrollback"},
		{"name": "pane.close", "kind": "client", "title": "close pane", "args": {"type": "object", "properties": {"confirm": {"type": "boolean"}}}},
		{"name": "pane.zoom", "kind": "client", "title": "zoom pane"},
		{"name": "pane.focus", "kind": "client", "title": "focus pane", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "down", "left", "up"]}}}},
		{"name": "pane.resize", "kind": "client", "title": "resize pane", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "down", "left", "up"]}, "cells": {"type": "integer", "minimum": 1}}}},
		{"name": "pane.next", "kind": "client", "title": "next pane"},
		{"name": "pane.last", "kind": "client", "title": "last pane"},
		{"name": "pane.attention", "kind": "client", "title": "next waiting program"},
		{"name": "layer.float", "kind": "client", "title": "toggle floating"},
		{"name": "pane.copy", "kind": "client", "title": "copy mode"},
		{"name": "pane.paste", "kind": "client", "title": "paste last copy"},
		{"name": "pane.choose", "kind": "client", "title": "choose pane by number"},
		{"name": "pane.clock", "kind": "client", "title": "show a clock"},
		{"name": "pane.find", "kind": "client", "title": "find in any pane"},
		{"name": "pane.hints", "kind": "client", "title": "copy text by hint"},
		{"name": "client.palette", "kind": "client", "title": "command palette"},
		{"name": "client.prompt", "kind": "client", "title": "command prompt"},
		{"name": "client.msg", "kind": "client", "title": "show a message", "args": {"type": "object", "properties": {"text": {"type": "string"}}, "required": ["text"]}},
		{"name": "buffer.choose", "kind": "client", "title": "paste an earlier copy"},
		{"name": "client.choose", "kind": "client", "title": "detach a client"},
		{"name": "client.detach_others", "kind": "client", "title": "detach other clients"},
		{"name": "client.config.reload", "kind": "client", "title": "reload config"},
		{"name": "mouse.toggle", "kind": "client", "title": "toggle mouse"},
		{"name": "pane.titles", "kind": "client", "title": "toggle pane titles"},
		{"name": "pane.dim", "kind": "client", "title": "dim unfocused panes"},
		{"name": "macro.record", "kind": "client", "title": "record macro"},
		{"name": "macro.play", "kind": "client", "title": "play macro"},
		{"name": "layer.new", "kind": "client", "title": "extra", "args": {"type": "object", "properties": {"command": {"type": "string"}, "keep": {"type": "boolean"}, "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}}}},
		{"name": "pane.pipe", "kind": "client", "title": "pipe output", "args": {"type": "object", "properties": {"command": {"type": "string"}}}},
		{"name": "pane.run", "kind": "client", "title": "run command", "args": {"type": "object", "properties": {"command": {"type": "string"}}, "required": ["command"]}},
		{"name": "layer.move", "kind": "client", "title": "move layer", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "down", "left", "up"]}, "cells": {"type": "integer", "minimum": 1}}}},
		{"name": "pane.swap", "kind": "client", "title": "swap pane", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "down", "left", "up"]}}}},
		{"name": "layer.raise", "kind": "client", "title": "raise layer"},
		{"name": "layer.lower", "kind": "client", "title": "lower layer"},
		{"name": "layer.minimize", "kind": "client", "title": "minimize layer"},
		{"name": "layer.restore", "kind": "client", "title": "restore minimized layer"},
		{"name": "layer.close", "kind": "client", "title": "close layer", "args": {"type": "object", "properties": {"confirm": {"type": "boolean"}}}},
		{"name": "layer.toggle_all", "kind": "client", "title": "toggle layers"},
		{"name": "layer.scratch", "kind": "client", "title": "toggle scratch float", "args": {"type": "object", "properties": {"opacity": {"type": "number", "minimum": 0, "maximum": 1}}}},
		{"name": "layer.scratch_tab", "kind": "client", "title": "toggle tab scratch float", "args": {"type": "object", "properties": {"opacity": {"type": "number", "minimum": 0, "maximum": 1}}}},
		{"name": "tab.new", "kind": "client", "title": "new tab", "args": {"type": "object", "properties": {"side": {"enum": ["before", "after"]}, "command": {"type": "string"}}}},
		{"name": "tab.next", "kind": "client", "title": "next tab"},
		{"name": "tab.previous", "kind": "client", "title": "previous tab"},
		{"name": "tab.last", "kind": "client", "title": "last tab"},
		{"name": "client.tab.goto", "kind": "client", "title": "go to tab", "args": {"type": "object", "properties": {"index": {"type": "integer"}}, "required": ["index"]}},
		{"name": "tab.move", "kind": "client", "title": "move tab", "args": {"type": "object", "properties": {"direction": {"enum": ["right", "left"]}}}},
		{"name": "tab.close", "kind": "client", "title": "close tab", "args": {"type": "object", "properties": {"confirm": {"type": "boolean"}}}},
		{"name": "tab.even", "kind": "client", "title": "even out panes"},
		{"name": "tab.sync", "kind": "client", "title": "synchronize panes"},
		{"name": "pane.group", "kind": "client", "title": "toggle typing group"},
		{"name": "tab.rename", "kind": "client", "title": "rename tab"},
		{"name": "tab.choose", "kind": "client", "title": "choose tab in any session"},
		{"name": "tab.layout", "kind": "client", "title": "layout", "args": {"type": "object", "properties": {"layout": {"enum": ["even-horizontal", "even-vertical", "main-horizontal", "main-vertical", "tiled", "next", "previous"]}}}},
		{"name": "tab.tile", "kind": "client", "title": "auto tile", "args": {"type": "object", "properties": {"layout": {"enum": ["even-horizontal", "even-vertical", "main-horizontal", "main-vertical", "tiled"]}}}},
		{"name": "client.mode.enter", "kind": "client", "title": "enter mode", "args": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
		{"name": "client.mode.exit", "kind": "client", "title": "exit mode"},
		{"name": "client.mode.exit_all", "kind": "client", "title": "exit all modes"}
	]
}"""

pub Binding :: struct {
	pub keys: []string,
	pub action: string,
	pub args: ?json.Json,
	pub mode: ?string,
}

pub Action :: struct {
	pub name: string,
	pub title: ?string,
	pub args: ?Schema,
}

pub Schema :: struct {
	pub required: ?[]string,
	pub properties: ?json.Json,
}

pub Config :: struct {
	pub hash: string,
}

pub Mode :: struct {
	pub name: string,
	pub exclusive: bool,
	pub blocked: ?[][]string,
}

pub Args :: struct {
	pub direction: ?string,
	pub name: ?string,
	pub cells: ?int,
	pub side: ?string,
	pub command: ?string,
	pub layout: ?string,
	pub index: ?int,
	pub session_id: ?string,
	pub window_id: ?string,
	pub opacity: ?float,
	pub text: ?string,
	pub confirm: ?bool,
	pub keep: ?bool,
	pub bounds: ?json.Arr,
}

pub Keymap :: struct {
	pub bindings: []Binding,
	pub actions: ?[]Action,
	pub modes: ?[]Mode,
	pub config: Config,
}

Request :: struct { pub actions: []Action }

pub request :: fn() !json.Obj {
	json.parse(REQUEST)? |> obj
}

pub arg_words :: fn(action: Action) []string {
	out := []string.{}
	props :: obj((action.args or Schema.{}).properties or :null)
	loop name in props.keys {
		out << name + "="
		loop value in arr(obj(props[name] or :null)["enum"] or :null) {
			match value {
				is string => { out << name + "=" + value; () },
				_ => {},
			}
		}
	}
	out
}

obj :: fn(value: json.Json) json.Obj {
	match value {
		is json.Obj => value,
		_ => []
	}
}
arr :: fn(value: json.Json) json.Arr {
	match value {
		is json.Arr => value,
		_ => []
	}
}

pub declared :: fn() ![]Action {
	json.decode[Request](REQUEST)?.actions
}

pub ours :: fn() ![string]() {
	out: [string]() = .[]
	loop action in declared()? do out[action.name] = ()
	out
}

pub can :: fn(km: Keymap) ![string]() {
	out := ours()?
	out["client.key.forward"] = ()
	loop action in km.actions or [] do out[action.name] = ()
	out
}

# the mode's bindings win, then the root's. drop means the mode ate the key
pub resolve :: fn(km: Keymap, typed: [][]string, can: [string](), mode: string) (binding: ?Binding, drop: bool) {
	if hit := find(km.bindings, typed, can, mode) do return (hit, false)
	if mode == "" do return
	loop entry in km.modes or [] {
		if entry.name != mode do continue
		if entry.exclusive do return (none, true)
		loop keys in entry.blocked or [] {
			if keys.len() == typed.len() && matches(keys, typed) do return
		}
	}
	binding = find(km.bindings, typed, can, "")
	return
}

find :: fn(bindings: []Binding, typed: [][]string, can: [string](), mode: string) ?Binding {
	bindings.find({ ($.mode or "") == mode && $.action in can && matches($.keys, typed) })
}

pub matches :: fn(keys: []string, typed: [][]string) bool {
	if keys.len() < typed.len() do return false
	loop i in 0..typed.len() {
		if keys[i] !in typed[i] do return false
	}
	true
}

## An action's keys for each direction share a row, like h/l. Submenus sorted first.
pub hint_rows :: fn(bindings: []Binding, depth: int, titles: [string]string) (rows: [](string, string), groups: int) {
	empty: json.Obj = []
	subs := [](string, string).{}
	keys, labels, bases, dirs := [][]string.{}, []string.{}, []string.{}, []string.{}
	loop i in 0..bindings.len() {
		earlier :: bindings[..(bindings.len() - 1 - i)]
		binding :: bindings[earlier.len()]
		key :: binding.keys[depth]
		if earlier.any({ $.keys[depth] == key }) do continue

		if binding.keys.len() > depth + 1 {
			under :: bindings.filter({ $.keys.len() > depth + 1 && $.keys[depth] == key })
			subs << (key, group(under.map({ $.action }), titles) + "…")
			continue
		}

		args :: json.from_json[Args](binding.args or { empty }) or Args.{}
		dir :: (args.direction or "") + " "
		base :: "{binding.action} {args.cells or 0} " + title_of(binding, titles, false)
		at := -1
		if dir != " " {
			loop j in 0..keys.len() {
				if at < 0 && bases[j] == base && !dirs[j].contains(dir) do at = j
			}
		}

		if at >= 0 {
			row := keys[at]
			row << key
			keys[at] = row
			labels[at] = title_of(binding, titles, false)
			dirs[at] += dir
			continue
		}

		keys << [key]
		labels << title_of(binding, titles)
		bases << if dir != " " do base else do ""
		dirs << dir
	}
	rows = [
		..subs,
		..(loop i in 0..keys.len() { (keys_of(keys[i]), labels[i]) }),
	]
	return (rows, subs.len())
}

group :: fn(actions: []string, titles: [string]string) (name: string) {
	if !actions.any({ $ != actions[0] }) do return titles[actions[0]] or { actions[0] }

	spaces :: loop action in actions {
		parts :: action.split(".")
		parts[math.max(parts.len() - 2, 0)]
	}
	loop space in spaces {
		if spaces.filter({ $ == space }).len() > spaces.filter({ $ == name }).len() {
			name = space
		}
	}
	return
}

keys_of :: fn(keys: []string) string {
	held :: mods(keys[0])
	if held == "" || keys.any({ mods($) != held }) do return keys.join("/")
	held + (loop key in keys do key[held.len()..]).join("/")
}

mods :: fn(key: string) string {
	i := key.len() - 2
	loop i >= 0 && key[i] != '+' do i -= 1
	key[..i + 1]
}

title_of :: fn(binding: Binding, titles: [string]string, dir := true) string {
	empty: json.Obj = []
	args :: json.from_json[Args](binding.args or { empty }) or Args.{}
	detail := args.command or args.layout or args.side or args.name or ""
	if dir do detail = args.direction or { detail }
	if i := args.index do detail = i.str()
	(titles[binding.action] or binding.action) + if detail != "" do " " + detail else do ""
}
