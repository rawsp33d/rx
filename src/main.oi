Done :: struct { client_actions: ?[]keymap.Binding }
Clients :: struct { clients: ?[]Peer }
Blocks :: struct { blocks: []Block }
Floated :: struct { layer_id: ?string }
Peer :: struct { client_id: ?string, principal: Principal, info: ?Info, connection_state: ?string }
Principal :: struct { display: string }
Info :: struct { name: ?string, version: ?string, label: ?string }

Clip :: struct { text: ?string, id: ?int, bytes: ?int }
Part :: struct { data: string, eof: bool }
Text :: struct { content: string, id: ?int, total: ?int }
Note :: struct { title: string, body: string }
Title :: struct { title: string }
Status :: struct { id: string, record: Record }
Record :: struct { id: ?string, state: string }
Records :: struct { records: []Record }
Removed :: struct { ids: []string }

reset_modes :: "\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1004l\e[?2004l\e[?1l\e[?66l\e[=0;1u\e[?25h\e[0 q\e[0m"

## All motion for link hover.
mouse_on :: "\e[?1003h\e[?1006h"

# outer kitty ids, past the scratch tints'
image_ids :: 1 << 24

Link :: struct { bid: string, at, reach: int }

## An OSC 8 link or a plain url under a cell, and the cells it spans.
link_at :: fn(term: ghostty.Term, x, y: int) (string, int, int) {
	url :: term.link(x, y)
	if url == "" {
		hit :: hits(term, y).find({
			$.text.contains("://") && $.x <= x && x < $.x + $.text.len()
		}) or return ("", 0, 0)
		return (hit.text, hit.x, hit.x + hit.text.len())
	}

	from, to := x, x + 1
	loop from > 0 && term.link(from - 1, y) == url {
		from -= 1
	}
	loop to < term.cols() && term.link(to, y) == url {
		to += 1
	}
	(url, from, to)
}

browse :: fn(url: string) {
	discard os.sh("xdg-open {quote(url)} >/dev/null 2>&1 &")
}

# secs a program may hold a frame (2026)
hold :: 1

main :: fn() {
	discard unsafe setlocale(0, "C.UTF-8".cstr()) # LC_CTYPE, for wcwidth
	cli(os.args()[1..]) or {
		eprint("rx: {$.message()}")
		os.exit(1)
	}
}

cli :: fn(args: []string) ! {
	args := args
	sock := os.env("REX_SERVER") or { "unix://" + (os.env("XDG_RUNTIME_DIR") or "") + "/rex/server.sock" }
	if args.len() > 1 && args[0] == "-S" {
		sock = args[1]
		args = args[2..]
	}
	autostart(sock)

	cmd := if args.len() > 0 do args[0] else do ""
	match cmd {
		"ls" => {
			if "-j" in args || "--json" in args do proxy(sock, "session ls --json", [])
			conn := rex.connect(sock)?
			loop session in conn.call[Sessions]("session.list")?.sessions do print(session.label)
			return ()
		},
		"kill" => proxy(sock, "kill", args[1..]),
		"rename" => proxy(sock, "session rename", args[1..]),
		"dump" => return dump(sock, named(args[1..])),
		"-CC" => return cc.run(sock, named(args[1..])),
		"help", "-h", "--help" => {
			print(usage)
			return ()
		},
	}

	# a command after -- runs in place of a shell
	opts := Options.{}
	sep :: args.index("--") or args.len()
	if sep < args.len() do opts.command = args[(sep + 1)..]
	args = args[0..sep]
	if i := args.index("-l") {
		if i + 1 < args.len() do opts.layout = args[i + 1]
		args = loop arg, k in args { if k == i || k == i + 1 do continue; arg }
	}
	opts.readonly = "-r" in args
	opts.alone = "-D" in args
	detached :: "-d" in args
	args = args.filter { $ !in ["-r", "-d", "-D"] }
	cmd = if args.len() > 0 do args[0] else do ""
	if cmd == "-" && !detached do args, cmd = [last(sock)?], ""

	opts.warp = cmd in ["w", "warp"]
	opts.bare = cmd == "run"
	needs_name :: opts.warp || cmd in ["j", "join"]
	if needs_name || opts.bare do args = args[1..]

	opts.label = if opts.bare || args.len() > 0 do named(args) else do "" # "" picks one
	known :: needs_name || cmd in ["", ".", "run"]
	nameless :: needs_name && args.len() == 0
	stray :: opts.command.len() > 0 && !opts.bare
	if !known || nameless || stray || args.len() > 1 || opts.label.starts_with("-") {
		eprint(usage)
		os.exit(2)
	}

	if detached && opts.label != "" {
		dir :: if opts.warp do zoxide(opts.label)? else do os.cwd()
		if opts.layout != "" {
			discard create(sock, opts.label, loop win in windows(opts.layout)? do with_cwd(win, dir))?
			return ()
		}

		rest := [opts.label, "--cwd", dir]
		if opts.command.len() > 0 do rest << "--" << opts.command
		proxy(sock, "new", rest) # like tmux new -d
	}

	# only a bare . renames, a flag means attach or create
	inside :: (os.env("REX_SESSION") or "") != ""
	if cmd == "." && inside && !opts.readonly && !detached && !opts.alone && opts.layout == "" {
		proxy(sock, "session rename", [opts.label])
	}

	run(sock, opts)
}

last :: fn(sock: string) !string {
	sid :: fs.read(fs.Path.(state() + "/last")) or ""
	conn := rex.connect(sock)?
	defer conn.close()
	sessions :: conn.call[Sessions]("session.list")?.sessions
	if !sessions.any({ $.session_id == sid }) do return error("no last session")
	sid
}

named :: fn(args: []string) string {
	if args.len() > 0 && args[0] != "." do return args[0]
	fs.Path.(os.cwd()).name()
}

usage :: "rx, a Rex TUI client

usage: rx [-S server] [command] [flags] [-- cmd...]

commands:
  (none)               interactive session browser
  -                    attach the last session, like cd -
  .                    create/join session named after cwd
                       inside a session with no flags, renames it instead
  j, join name         create/join session in current dir
  w, warp name         create/join session after warping to the given dir (needs zoxide)
  run [name] -- cmd    create session running cmd instead of a shell, no status line, like abduco
  dump [name]          print a session as a layout file, for -l
  -CC [name]           tmux control mode for wezterm, like tmux -CC
  ls [-j, --json]      list sessions
  rename [session] name
                       rename a session, the current one by default
  kill name...         kill sessions
  help                 show this

flags:
  -l file     create a session from a layout file
  -r          read-only
  -d          don't attach
  -D          detach other clients
  -S server   unix socket or host:port, default $REX_SERVER

name is a session label or id, . means the cwd's name"

Layout :: struct { initial_windows: []Json }

windows :: fn(path: string) !json.Arr {
	fs.Path.(path) |> fs.read($)? |> json.decode[Layout]($)? |> $.initial_windows
}

create :: fn(sock, label: string, wins: json.Arr) !string {
	conn := rex.connect(sock)?
	defer conn.close()
	plain: json.Arr = loop win in wins {
		kept: Obj = []
		loop value, key in obj(win) {
			if key != "floats" do kept[key] = value
		}
		Json.(kept)
	}
	created :: conn.call[Created]("session.create", ["label" = label, "initial_windows" = plain])?
	sid :: created.session_id
	if plain.str() != Json.(wins).str() {
		discard conn.call[Attached]("session.attach", ["session_id" = sid])?
	}

	loop win in wins, tab in created.initial_windows or [] {
		loop layer in arr(obj(win)["floats"] or :null) {
			discard conn.call[Ok]("session.new_layer", [
				"session_id" = sid,
				"window_id" = tab.window_id,
				"bounds" = obj(layer)["bounds"] or :null,
				"layout" = obj(layer)["layout"] or :null,
			])?
		}
	}
	sid
}

# TODO: commands, Rex keeps their arguments to itself. minimized floats come back shown
dump :: fn(sock, label: string) ! {
	conn := rex.connect(sock)?
	defer conn.close()
	discard conn.call[Sessions]("session.attach_all", ["event_scope" = "session"])?
	sessions :: conn.call[Sessions]("session.list")?.sessions
	session :: sessions.find({ $.label == label || $.session_id == label }) or return error("no session {label}")
	sid :: session.session_id
	empty: Obj = []
	cwds: [string]string = .[]
	wins: json.Arr = []
	loop win in conn.call[View]("session.view", ["session_id" = sid])?.windows or [] {
		entry: Obj = []
		floats: json.Arr = []
		if !default_label(win) do entry["window_label"] = win.label or ""
		loop layer in win.layers {
			loop leaf in leaves(layer.layout or :null) {
				args: Obj = ["session_id" = sid, "block_id" = leaf.bid, "args" = empty]
				cwds[leaf.bid] = (conn.call[Process]("com.superlogical.terminal.process", args) or Process.{}) |> rex.cwd($)
			}
			lay :: spec(layer.layout or :null, cwds)
			if layer.kind == "tiled" {
				entry["layout"] = lay
			} else {
				floats << ["bounds" = layer.bounds.map({ Json.($) }), "layout" = lay]
			}
		}
		if floats.len() > 0 do entry["floats"] = floats
		wins << Json.(entry)
	}
	Json.(["initial_windows" = wins]) |> $.str() |> print
}

with_cwd :: fn(node: Json, cwd: string) Json {
	match node {
		is json.Arr => Json.(loop item in node do with_cwd(item, cwd)),
		is Obj => {
			fields := node
			loop key in node.keys do fields[key] = with_cwd(node[key] or :null, cwd)
			flavor :: fields["flavor"] or :null
			if !(match flavor { is string => flavor.starts_with("com.superlogical.terminal."), _ => false }) {
				return Json.(fields)
			}
			opts := obj(fields["options"] or :null)
			if "cwd" !in opts do opts["cwd"] = cwd
			fields["options"] = opts
			Json.(fields)
		},
		_ => node,
	}
}

obj :: fn(value: Json) Obj { match value { is Obj => value, _ => [] } }
arr :: fn(value: Json) json.Arr { match value { is json.Arr => value, _ => [] } }

spec :: fn(tree: Json, cwds: [string]string) Json {
	node :: json.from_json[Node](tree) or return :null
	if bid := node.block_id do return Json.(rex.shell(cwds[bid] or ""))
	split :: node.split or return :null
	Json.(["split" = [
		"direction" = split.direction, "ratio" = split.ratio,
		"before" = spec(split.before, cwds), "after" = spec(split.after, cwds),
	]])
}

default_label :: fn(win: Window) bool {
	label :: win.label or ""
	label.starts_with("Window ") && win.window_id.ends_with(label[7..])
}

proxy :: fn(sock, cmd: string, rest: []string) {
	os.exit(rest.map(quote)
		|> $.join(" ")
		|> os.sh("rex -S {quote(sock)} {cmd} " + $)
		|> int.($))
}

autostart :: fn(sock: string) {
	path :: if sock.starts_with("unix://") do sock[7..] else do sock
	if !path.starts_with("/") && path.split(":").len() == 2 do return
	conn :: net.connect_unix(path) or {
		discard os.sh("rex -S {quote(sock)} server start >/dev/null")
		return
	}
	conn.close()
}

quote :: fn(text: string) string { "'" + text.replace("'", "'\\''") + "'" }

popen : fn(cmd: cstr, mode: cstr) ptr : foreign
pclose : fn(f: ptr) i32 : foreign
fflush : fn(f: ptr) i32 : foreign

# popen by hand, os.sh keeps no output
zoxide :: fn(query: string, flags := "") !string {
	words :: query.split(" ").filter({ $ != "" }).map({ quote($) }).join(" ")
	file :: unsafe popen("zoxide query {flags} -- {words} 2>/dev/null".cstr(), "r".cstr())
	if file.is_null() do return error("cannot run zoxide")

	out: []u8
	loop {
		byte :: unsafe libc.fgetc(file)
		if byte < 0 do break
		out << u8.(byte)
	}
	if unsafe pclose(file) != 0 do return error("zoxide: no match for {query}")

	string.(out).trim()
}

Options :: struct {
	label, layout: string
	command: []string
	warp, readonly, alone, bare: bool
}

run :: fn(sock: string, opts: Options) ! {
	conn := rex.connect(sock)?
	defer conn.close()
	term :: tty.raw(0)?
	out("\e[?1049h")
	defer out(reset_modes + "\e[?1049l")
	input := Input.{ chan = tty.input(0) }
	resizes :: tty.resizes(1)

	label := opts.label
	dir := if opts.warp do zoxide(label)? else do ""
	choose := label == ""
	cur, prev := "", "" # for session.last
	loop {
		sessions :: conn.call[Sessions]("session.list")?.sessions
		if choose do label, dir = pick(sock, sessions, mut input, label)
		if label == "" do break
		sid := ""
		if session := sessions.find({ $.label == label || $.session_id == label }) {
			sid, label = session.session_id, session.label
		}
		# it would draw itself inside itself forever
		if sid != "" && sid == (os.env("REX_SESSION") or "") do return error("already in {label}")
		if sid == "" {
			shell: Obj = []
			if opts.command.len() > 0 do shell["command"] = opts.command.map({ Json.($) })
			cwd :: if dir != "" do dir else do os.cwd()
			wins: json.Arr = [["layout" = rex.shell(cwd, shell)]]
			if opts.layout != "" do wins = windows(opts.layout)?.map({ with_cwd($, cwd) })
			sid = create(sock, label, wins)?
		}
		if sid != cur do prev, cur = cur, sid
		att :: conn.call[Attached]("session.attach", ["session_id" = sid])?
		fs.mkdir(fs.Path.(state())) or {}
		fs.write(fs.Path.(state() + "/last"), sid) or {}
		view := att.view
		if (view.windows or []).len() == 0 {
			discard conn.call[Ok]("session.new_window", ["session_id" = sid, "layout" = rex.shell(os.cwd())])?
			view = conn.call[View]("session.view", ["session_id" = sid])?
		}
		client := Client.{
			conn = conn, sock = sock, sid = sid, cid = att.client_id,
			owned = !opts.readonly, readonly = opts.readonly, bare = opts.bare, prev = prev,
			chunks = sync.Chan[rex.Chunk].{}, keys = input,
		}
		client.load_keymap()?
		out("\e]11;?\e\\")
		# like tmux attach -d
		if opts.alone {
			loop peer in client.others()? do client.kick(peer) or {}
		}
		client.apply(view)?
		client.pump(resizes) or {
			client.close()
			conn = client.conn
			return $
		}
		client.close()
		conn = client.conn
		input = client.keys
		if !client.choose && client.next == "" do break
		choose = client.next == ""
		label, dir = if client.next != "" do (client.next, client.dir) else do (label, "")
		discard conn.call[Ok]("session.detach", ["session_id" = sid]) or Ok.{}
	}
}

pick :: fn(sock: string, sessions: []Session, mut input: Input, at: string) (string, string) {
	sessions := sessions
	list := List.{
		title = "Sessions"
		cmds = [
			("alt+enter" "new")
			("ctrl+r" "rename")
			("tab" "mark")
			("ctrl+x" "close")
			("alt+up" "move up")
			("alt+down" "move down")
		]
		numbered = true
	}
	start :: if at != "" do at else {
		fs.read(fs.Path.(state() + "/last")) or ""
	}
	loop session, j in sessions {
		if start in [session.label session.session_id] do list.at = j
	}

	bad: string
	marks: []string
	previews: [string][]string
	loop {
		out("\e[0m\e[H\e[2J" + bottom + "\e[31m{bad}\e[0m")
		bad = ""
		counts :: viewers(sock, sessions)
		list.tags = loop session, j in sessions {
			number :: if j < 9 do "{j + 1}" else do " "
			here :: if session.label == at do "*" else do " "
			other :: if counts[j] > 0 do "+" else do " "
			mark :: if session.session_id in marks do "x" else do " "
			"{number} {here}{other}{mark} "
		}
		labels :: sessions.map({ $.label })
		list.items = labels
		home :: os.env("HOME") or ""

		# enter takes the dir drawn, zoxide's db can change under it
		cache: [string][]string = .[]
		rows :: fn [mut cache, home, labels] (query: string) []string {
			if query != "" && query !in cache {
				found :: zoxide(query, "-l") or ""
				cache[query] = found.split("\n").filter({ $ != "" && fs.Path.($).name() !in labels })
			}
			loop dir in cache[query] or [] {
				"new in " + if dir.starts_with(home) do "~" + dir[home.len()..] else do dir
			}
		}

		look :: fn [mut previews, sock, sessions] (index: int) []string {
			sid :: sessions[index].session_id
			if sid !in previews do previews[sid] = peek(sock, sid) or []
			previews[sid] or []
		}

		picked, name :: list.choose(mut input, rows, look)
		query :: list.query

		if name in ["", "esc", "ctrl+c"] {
			# back to the session it was opened from, if that's still around
			if name != "" && sessions.any({ $.label == at }) do return (at, "")
			return ("", "")
		}
		if name == "alt+enter" || name == "enter" && (picked < 0 || query == ".") {
			return (if query == "" do "main" else do named([query]), "")
		}

		if picked >= sessions.len() {
			dir :: (cache[query] or [])[picked - sessions.len()]
			if name == "enter" do return (fs.Path.(dir).name(), dir)
			continue
		}

		if picked < 0 do continue

		id :: sessions[picked].session_id
		if name == "enter" do return (sessions[picked].label, "")

		if name == "tab" {
			marks = toggle(marks, id)
			list.at += 1
		}

		if name == "ctrl+r" {
			label :: ask(mut input, "rename {sessions[picked].label}: ")
			if label != "" {
				args: Obj = ["session_id" = id, "label" = label]
				sessions = manage(sock, "session.set_label", args) or { bad = $.message(); sessions }
			}
		}

		if name == "ctrl+x" {
			targets :: if marks.len() > 0 do marks else do [id]
			names :: sessions.filter({ $.session_id in targets }).map({ $.label }).join(", ")
			out(bottom + "close {names}? y to confirm")
			answer :: input.next() or return ("", "")
			if answer.names[0] == "y" {
				loop target in targets {
					sessions = manage(sock, "session.destroy", ["session_id" = target]) or { bad = $.message(); sessions }
				}
				marks = []
			}
		}

		if name == "alt+down" && picked + 1 < sessions.len() {
			args: Obj = ["session_id" = id]
			if picked + 2 < sessions.len() do args["before_session_id"] = sessions[picked + 2].session_id
			sessions = manage(sock, "session.move", args) or { bad = $.message(); continue }
			list.at += 1
		}

		if name == "alt+up" && picked > 0 {
			args: Obj = ["session_id" = id, "before_session_id" = sessions[picked - 1].session_id]
			sessions = manage(sock, "session.move", args) or { bad = $.message(); continue }
			list.at -= 1
		}
	}
}

viewers :: fn(sock: string, sessions: []Session) []int {
	conn := rex.connect(sock) or return sessions.map({ 0 })
	defer conn.close()

	discard conn.call[Sessions]("session.attach_all", ["event_scope" = "session"]) or Sessions.{}
	loop session in sessions {
		found :: conn.call[Clients]("session.list_clients", ["session_id" = session.session_id]) or Clients.{}
		(found.clients or []).len()
	}
}

state :: fn() string {
	(os.env("XDG_STATE_HOME") or { (os.env("HOME") or "") + "/.local/state" }) + "/rx"
}

Input :: struct { chan: sync.Chan[string], unread: string }

Input :< {
	next :: fn(mut self) ?keys.Key {
		loop {
			if self.unread == "" do self.unread = self.chan.recv() or return none
			# key_of only knows ascii, so a byte past it is text
			if self.unread[0] >= 0x80 {
				text :: self.unread[..1]
				self.unread = self.unread[1..]
				return keys.Key.{ names = [text], action = "press", text = text }
			}
			parsed, used :: keys.key_of(self.unread)
			self.unread = self.unread[used..]
			return parsed or continue
		}
	}
}

# the prompt row
bottom :: "\e[999;1H\e[0m\e[2K "

List :: struct {
	title: string
	items, tags: []string
	cmds: [](string, string)
	numbered: bool
	at: int # counts items, not hits
	query: string
}

List :< {
	choose :: fn(
		with mut self; mut input: Input,
		more: fn(string) []string = { [] },
		preview: ?fn(int) []string = none,
	) (picked: int, name: string) {
		picked = -1
		size :: tty.size(1) or return

		cols, rows :: int.(size.cols), int.(size.rows)
		wide :: cols >= 100 && preview != none
		w :: if wide do 40 else do min(cols - 2, 60)
		shortcuts := [("enter" "pick")]
		shortcuts << cmds
		if numbered do shortcuts << ("alt+1-9" "goto")

		shortcuts << ("esc" "cancel")
		foot :: legend(shortcuts, w - 2)
		room :: rows - foot.len() - 6
		x := if wide do 0 else do (cols - w - 2) / 2
		gutter, visible := 0, 1

		loop tag in tags do gutter = max(gutter, cells(tag))

		i := items[..min(at, items.len())].filter({ fuzzy(self.query, $) }).len()
		loop {
			picked, name = -1, ""
			all :: [..items, ..more(query)]
			hits: []int = loop item, k in all {
				if k < items.len() && !fuzzy(query, item) do continue
				k
			}

			# only grows, a smaller box leaves the old one's edges
			visible = (if wide do rows else do all.len()) |> min($, room) |> max($, visible)
			y :: max((room - visible) / 2, 0)

			i = clamp(i, 0, max(hits.len() - 1, 0))
			off :: max(i - visible + 1, 0)
			shown: []string = loop k in 0..visible {
				if k + off < hits.len() {
					hit :: hits[k + off]
					tag :: if hit < tags.len() do tags[hit] else do ""
					pad(tag, gutter) + accent(all[hit], matches(query, all[hit]))
				} else do ""
			}
			on :: if hits.len() > 0 do i - off else do -1
			out(reset_modes + "\e[?2026h" + box(x, y, w, title, shown, on, ["> {query}"], foot))

			if look := preview; wide {
				lines: []string = if on >= 0 && hits[i] < items.len() do look(hits[i]) else do []
				# as tall as the list box, with its query and rules
				height :: visible + foot.len() + 3
				skip :: max(lines.len() - height, 0)
				tail: []string = loop j in 0..height {
					if j + skip < lines.len() do lines[j + skip] else do ""
				}
				out(box(x + w + 2, y, cols - w - 4, "", tail))
			}
			out("\e[{y + 2};{x + 5 + cells(query)}H\e[?25h\e[?2026l")

			key :: input.next() or return
			if key.action != "press" do continue
			name = key.names[0]
			if name in ["esc", "ctrl+c"] do return
			if numbered && name.starts_with("alt+") {
				digit :: int.try_from(name[4..]) or 0
				if digit >= 1 && digit <= min(items.len(), 9) {
					at = digit - 1
					return (at, "enter")
				}
			}

			if i < hits.len() do picked = hits[i]
			if name == "enter" || cmds.any({ $.0 == name }) {
				if picked >= 0 do at = picked
				return
			}

			if name in ["down" "ctrl+n" "tab"] do i += 1
			if name in ["up" "ctrl+p" "shift+tab"] do i = max(i - 1, 0)
			if name in ["backspace" "ctrl+h"] do query = chop(query)
			if key.text != "" && name != "tab" {
				query += key.text
				i = 0
			}
		}
	}
}

manage :: fn(sock, method: string, payload: Obj) ![]Session {
	conn := rex.connect(sock)?
	defer conn.close()
	discard conn.call[Sessions]("session.attach_all", ["event_scope" = "session"])?
	discard conn.call[Ok](method, payload)?
	conn.call[Sessions]("session.list")?.sessions
}

## A tab's focused pane as text, the active tab's by default.
peek :: fn(sock, sid: string, wid := "") ![]string {
	conn := rex.connect(sock)?
	defer conn.close()

	discard conn.call[Sessions]("session.attach_all", ["event_scope" = "session"])?
	view :: conn.call[View]("session.view", ["session_id" = sid])?
	tab :: if wid != "" do wid else do view.active_window_id or ""
	win :: (view.windows or []).find({ $.window_id == tab }) or return []

	args: Obj = [
		"session_id" = sid,
		"block_id" = win.focused_block_id or "",
		"args" = ["trim" = true, "max_bytes" = 1.0],
	]
	text :: conn.call[Text]("com.superlogical.terminal.format", args)?
	id :: text.id or return text.content.split("\n").map(printable)

	# a long scrollback won't fit one reply, and only its tail shows
	tail :: 32768
	from :: max((text.total or 0) - tail, 0)
	args["args"] = ["id" = float.(id), "offset" = float.(from), "max_bytes" = float.(tail)]
	lines :: conn.call[Part]("com.superlogical.terminal.blob_read", args)?.data.split("\n")
	lines[(if from > 0 do 1 else do 0)..].map(printable)
}

ask :: fn(mut input: Input, prompt: string, names: []string = [], args: [string][]string = .[]) (line: string) {
	loop {
		out(bottom + "{prompt}{line}\e[?25h")
		key :: input.next() or return ""
		name :: key.names[0]
		if name == "enter" do return
		if name in ["esc", "ctrl+c"] do return ""
		if name in ["backspace", "ctrl+h"] do line = chop(line)
		if name == "tab" do line = complete(line, names, args) else do line += key.text
	}
}

toggle :: fn(items: []string, item: string) []string {
	if item in items do return items.filter({ $ != item })
	[..items, item]
}
minimized :: fn(win: Window) bool {
	win.layers.any({ ($.state or "") == "minimized" })
}

command :: fn(fg: ?Proc) string {
	proc :: fg or return ""
	name :: fs.Path.(proc.script or proc.argv0 or proc.name).name()
	if name.starts_with("-") do name[1..] else do name # a login shell's -zsh
}

urgency :: fn(state: string) int {
	["", "done", "working", "error", "blocked"].index(state) or 0
}

marks :: ["", " ✓", " …", " ✗", " ?"]

# so a program's text can't sneak in escapes
printable :: fn(text: string) string {
	out: []u8 = loop i in 0..text.len() { if text[i] < 0x20 || text[i] == 0x7f do continue; text[i] }
	string.(out)
}

popup :: fn() json.Arr { [0.1, 0.1, 0.8, 0.8] }

runs :: fn(cmd: string) Obj {
	opts: Obj = []
	if cmd != "" do opts["command"] = ["sh", "-c", cmd]
	opts
}
around :: fn(tree: Json, bid, direction: string) ?Node {
	node :: json.from_json[Node](tree) or return none
	split :: node.split or return none
	if inner := around(split.before, bid, direction) do return inner
	if inner := around(split.after, bid, direction) do return inner
	if split.direction != direction do return none
	if leaves(tree).any({ $.bid == bid }) do return node
	none
}
Drag :: struct {
	kind: string # split, float, corner, tab, pill, select, program, eat or ""
	x, y: int
	node: Node
	area: Area
	id: string
	bounds: []float
	moved: bool
	px, py: int
	edge: bool
	block: bool
}

Drag :< {
	resizing :: fn(self) bool {
		self.kind in ["split", "float", "corner"]
	}
}

moving :: fn(seq: string) bool {
	_, fin, used := keys.csi(seq)
	if !seq.starts_with("\e[<") || fin != 'M' do return false
	button :: sgr(seq[..used]).0
	button >= 0 && button & 32 != 0
}

# SGR and X10 only, no 1005 or 1015
report :: fn(term: ghostty.Term, button, x, y: int, up: bool) string {
	want :: if button & 32 != 0 {
		term.mode(1003) || term.mode(1002) && button & 3 != 3
	} else {
		term.mode(1000) || term.mode(1002) || term.mode(1003)
	}
	if !want do return scroll(term, button)
	if term.mode(1006) do return "\e[<{button};{x + 1};{y + 1}" + if up do "m" else do "M"
	if x > 222 || y > 222 do return ""
	"\e[M" + string.([u8.(32 + if up do button | 3 else do button), u8.(33 + x), u8.(33 + y)])
}

scroll :: fn(term: ghostty.Term, button: int) string {
	if button & 98 != 64 || !term.mode(1007) || !(term.mode(1049) || term.mode(1047) || term.mode(47)) {
		return ""
	}
	arrow :: (if term.mode(1) do "\eO" else do "\e[") + if button & 1 == 0 do "A" else do "B"
	arrow + arrow + arrow # three lines a notch, like wezterm
}

sgr :: fn(seq: string) (button, x, y: int, up: bool) {
	fields :: seq[3..(seq.len() - 1)].split(";")
	if fields.len() != 3 do return (-1, 0, 0, false)
	button = int.try_from(fields[0]) or 0
	x = (int.try_from(fields[1]) or 0) - 1
	y = (int.try_from(fields[2]) or 0) - 1
	up = seq.ends_with("m")
	return
}

Item :: struct { label, key, action: string, args: Obj }

pane_items :: fn() []Item {
	[
		Item.{ label = "Split Right", key = "l", action = "pane.split", args = ["direction" = "right"] },
		Item.{ label = "Split Down", key = "j", action = "pane.split", args = ["direction" = "down"] },
		Item.{ label = "Zoom", key = "z", action = "pane.zoom" },
		Item.{ label = "Float", key = "f", action = "layer.float" },
		Item.{ label = "Copy Mode", key = "c", action = "pane.copy" },
		Item.{ label = "Paste", key = "p", action = "pane.paste" },
		Item.{ label = "Close", key = "X", action = "pane.close" },
	]
}

tab_items :: fn() []Item {
	[
		Item.{ label = "Move Left", key = "<", action = "tab.move", args = ["direction" = "left"] },
		Item.{ label = "Move Right", key = ">", action = "tab.move", args = ["direction" = "right"] },
		Item.{ label = "Rename", key = "r", action = "tab.rename" },
		Item.{ label = "New After", key = "n", action = "tab.new", args = ["side" = "after"] },
		Item.{ label = "New at End", key = "N", action = "tab.new" },
		Item.{ label = "Next Layout", key = "w", action = "tab.layout" },
		Item.{ label = "Close", key = "X", action = "tab.close" },
	]
}

session_items :: fn() []Item {
	[
		Item.{ label = "Next", key = "l", action = "session.next" },
		Item.{ label = "Previous", key = "h", action = "session.previous" },
		Item.{ label = "Choose", key = "s", action = "session.choose" },
		Item.{ label = "Rename", key = "r", action = "session.rename" },
		Item.{ label = "New", key = "n", action = "session.new" },
		Item.{ label = "Warp", key = "w", action = "session.warp" },
		Item.{ label = "Detach", key = "d", action = "detach" },
		Item.{ label = "Close", key = "X", action = "session.close" },
	]
}
axis :: fn(dir: string) string { if dir == "left" || dir == "right" do "horizontal" else do "vertical" }
side :: fn(dir: string) string { if dir == "left" || dir == "up" do "before" else do "after" }
Pane :: struct {
	bid: string
	id: int
	stream: rex.Stream
	strip: strip.Strip
	got: string
	read: int
	ended: bool
	term: ghostty.Term
	painted, full: bool
	sized: bool
	layer: int
	holding: bool
	since: time.Instant
	x, y, w, h: int
	placed: int
	sent: []int # kitty image ids
}

Pane :< {
	feed :: fn(mut self; data, cid: string) bool {
		buf := data
		if !self.painted {
			self.got += data
			term, rest := ghostty.decode(self.got) or return true
			self.term = term
			self.painted = true
			self.full = true
			buf = self.got[rest..]
			self.got = ""
		}
		vt :: self.strip.feed(buf)
		ours := true
		at := 0
		loop (i, msg) in self.strip.msgs {
			self.term.write(vt[at..i])
			at = i
			event :: json.decode[Rex1](msg) or continue
			if event.type == "child_exited" do self.term.write("\r\n[exited {event.exit_code or 0}]")
			if event.type != "resize" do continue
			self.term.resize(event.cols or 1, event.rows or 1)
			self.full = true
			# the first resize is the snapshot's size, from before the claim
			if (event.owner or "") != cid && self.sized do ours = false
			self.sized = true
		}
		self.strip.msgs = []
		self.term.write(vt[at..])
		ours
	}

	draw :: fn(mut self; all: bool, paint: ghostty.Paint) string {
		if !self.painted do return ""
		held :: !all && self.term.held()
		if held && !self.holding do self.since = time.Instant.now()
		self.holding = held
		if held && self.since.elapsed() < hold.sec() do return ""
		self.full = false
		self.term.draw(self.x, self.y, self.w, self.h, all, paint)
	}

	images :: fn(mut self; cleared: bool) string {
		if !self.painted do return ""

		placed :: self.term.placed()
		if !cleared && placed == self.placed do return ""

		self.placed = placed
		images :: self.term.placements()
		ids :: images.map({ image_ids + $.generation })
		buf := Buffer.{}

		loop id in self.sent {
			mode :: if id in ids do "i" else do "I"
			buf.write("\e_Ga=d,d={mode},i={id},q=2\e\\")
		}

		self.sent = if cleared do [] else do self.sent.filter({ $ in ids })
		loop i in 0..images.len() {
			id :: ids[i]
			if id !in self.sent {
				buf.write(self.term.upload(images[i].id, id))
				self.sent << id
			}
			buf.write(self.term.place(images[i], id, self.x, self.y, self.w, self.h))
		}

		buf.str()
	}

	close :: fn(self) {
		self.stream.close()
		if self.painted do self.term.free()
		loop id in self.sent do out("\e_Ga=d,d=I,i={id},q=2\e\\")
	}
}

Pipe :: struct {
	bid: string
	id: int
	stream: rex.Stream
	strip: strip.Strip
	got: string
	live: bool
	read: int
	file: ptr
}

Pipe :< {
	feed :: fn(mut self; data: string) {
		self.read += data.len()
		buf := data
		if !self.live {
			self.got += data
			term, rest := ghostty.decode(self.got) or return
			term.free()
			buf = self.got[rest..]
			self.got = ""
			self.live = true
		}
		vt :: self.strip.feed(buf)
		self.strip.msgs = []
		if vt == "" do return
		discard unsafe libc.fwrite(vt.ptr, 1, usize.(vt.len()), self.file)
		discard unsafe fflush(self.file)
	}

	close :: fn(self) {
		self.stream.close()
		file :: self.file
		discard sync.spawn! { discard unsafe pclose(file) } # don't wait on a command that won't end
	}
}

Client :: struct {
	conn, aux: rex.Rex # aux is for pipes, Rex gives a client one stream per block
	sock, sid, cid, aux_cid: string
	bid, wid: string
	last_wid, prev: string # for tab.last and session.last
	last_bid: [string]string # for pane.last
	view: View
	panes: []Pane
	pipes: []Pipe
	chunks: sync.Chan[rex.Chunk]
	keys: Input
	streams, cols, rows, revision, edits, peers: int
	cell_w, cell_h: int # in pixels, zero if the terminal doesn't report
	modes: string
	owned: bool
	full, readonly, bare, mouse_off, dim, recording: bool
	frames: bool # like tmux's pane-border-status bottom
	choose, detach: bool
	next, dir: string
	km: keymap.Keymap
	can, ours: [string]()
	hash: string
	modes_on: []string # innermost last
	typed: [][]string
	eaten: []string # keys a binding took, their release and repeats drop too
	titles: [string]string
	arg_words: [string][]string
	areas: []Area
	msg, shown, hinted: string
	msg_at: time.Instant
	bad: bool
	fg, named, labels: [string]string
	opacities: [string]float # by scratch label
	bg: string # OSC 11
	status: [string]string # OSC 7501, by block id, newline, record id
	seen: [string]()
	layout: int
	tiling, tiled_as: [string]string # auto tiling like dvtm, by window
	cp, land: Copy
	parked: []Copy
	buffers: []string
	drag: Drag
	link: Link
	clicks: int
	click, flash: string
	click_at: time.Instant
	tabs: []int
	marked: string
	synced, grouped, belled: []string
	tape, macro: string
	mark: int
}

Client :< {
	pump :: fn(mut self; resizes: sync.Chan[tty.Size]) ! {
		loop {
			self.serve(resizes) or {
				if !self.conn.lost do return $
				self.reconnect()?
				continue
			}
			return ()
		}
	}

	reconnect :: fn(mut self) ! {
		typed := ""
		at :: time.Instant.now()
		loop {
			self.say("reconnecting, C-c quits", true)
			self.conn = self.conn.reconnect() or {
				if at.elapsed() > 2.min() do return error("lost the server")
				sync.select! {
					got := <-self.keys.chan => {
						buf :: got or return error("input closed")
						parsed, _ := keys.key_of(buf)
						if "ctrl+c" in (parsed or keys.Key.{}).names do return error("lost the server")
						typed += buf
						()
					},
					sync.after(1.sec()) => {},
				}
				continue
			}
			break
		}
		if !self.conn.resumed {
			self.cid = self.call[Attached]("session.attach")?.client_id
			self.load_keymap()?
		}
		self.say("reconnected")
		self.apply(self.call[View]("session.view")?)?
		loop i in 0..self.panes.len() {
			if self.panes[i].ended do self.revive(i)
		}
		discard self.input(typed)?
	}

	serve :: fn(mut self; resizes: sync.Chan[tty.Size]) ! {
		loop :run {
			loop {
				event :: self.conn.queued() or break
				if self.event(event)? do break :run
			}
			if self.panes.len() == 0 do break
			sync.select! {
				got := <-self.keys.chan => {
					buf := got or break :run
					loop self.drag.resizing() {
						buf += self.keys.chan.try_recv() or break
					}
					if self.input(buf)? do break :run
				},
				_ := <-resizes => {
					self.owned = true
					self.relayout()?
				},
				msg := <-self.conn.inbox => self.conn.take(msg)?,
				chunk := <-self.chunks => {
					self.data(chunk or break :run)
					loop 0..64 do self.data(self.chunks.try_recv() or break)
					self.draw()
				},
				sync.after(self.wake()) => self.tick(),
			}
		}
	}

	apply :: fn(mut self; view: View) ! {
		self.view = view
		self.fetch_status()
		self.relayout()?
		self.retile()?
		if self.land.bid != self.bid do self.land = Copy.{}
	}

	retile :: fn(mut self) ! {
		name :: self.tiling[self.wid] or return ()
		bids :: self.tiled()
		key :: bids.join(" ")
		if (self.tiled_as[self.wid] or "") == key do return ()
		tiled_as := self.tiled_as # can't index assign a field's map
		tiled_as[self.wid] = key
		self.tiled_as = tiled_as
		self.arrange(bids, name)?
	}

	tiled :: fn(self) []string {
		layer :: self.win().layers.find({ $.kind == "tiled" }) or return []
		leaves(layer.layout or :null).map({ $.bid })
	}

	arrange :: fn(mut self; bids: []string, name: string) ! {
		loop step in arrange(bids, name) {
			self.ok("session.move_block", [
				"block_id" = step.bid, "anchor_block_id" = step.anchor,
				"direction" = step.direction, "side" = "after", "ratio" = step.ratio,
			])?
		}
	}

	fetch_status :: fn(mut self) {
		fg, status, seen := self.fg, self.status, self.seen # can't index assign a field's map
		loop win in self.view.windows or [] {
			bid :: win.focused_block_id or ""
			if bid != "" && bid !in fg {
				fg[bid] = (self.tcall[Process](bid, "process") or Process.{}) |> command($.foreground)
			}
			loop layer in win.layers; leaf in leaves(layer.layout or :null) {
				if leaf.bid in seen do continue
				seen[leaf.bid] = ()
				records :: self.tcall[Records](leaf.bid, "program_status") or continue
				loop record in records.records do status[leaf.bid + "\n" + (record.id or "")] = record.state
			}
		}
		self.fg = fg
		self.status = status
		self.seen = seen
		if !self.frames do return
		labels: [string]string = .[]
		blocks :: (self.call[Blocks]("session.list_blocks") or Blocks.{}).blocks
		loop block in blocks do labels[block.block_id] = block.label or ""
		self.labels = labels
	}

	read_clip :: fn(mut self; bid: string, id: int) string {
		text := ""
		loop {
			args: Obj = ["id" = float.(id), "offset" = float.(text.len()), "max_bytes" = 983040.0]
			part :: self.tcall[Part](bid, "clipboard_read", args) or return ""
			text += part.data
			if part.eof || part.data == "" do return text
		}
	}

	state :: fn(self; bid: string) worst: string {
		loop state, key in self.status {
			if key.starts_with(bid + "\n") && urgency(state) > urgency(worst) do worst = state
		}
		return
	}

	win_state :: fn(self; win: Window) worst: string {
		loop layer in win.layers; leaf in leaves(layer.layout or :null) {
			state :: self.state(leaf.bid)
			if urgency(state) > urgency(worst) do worst = state
		}
		return
	}

	block_event :: fn(mut self; change: Change) {
		bid :: change.block_id or ""
		name :: change.name or ""
		payload :: change.payload or :null
		if name == "bell" do self.bell(bid)
		if name in ["title_changed", "program_status_changed", "program_status_removed"] && self.frames {
			self.full = true
		}
		if name == "clipboard_written" {
			clip :: json.from_json[Clip](payload) or Clip.{}
			text :: clip.text or if (clip.bytes or 0) > 0 do self.read_clip(bid, clip.id or 0) else do ""
			if text != "" do self.clip(text)
		}
		if name == "desktop_notification" {
			note :: json.from_json[Note](payload) or return
			title :: if note.title != "" do note.title else do self.view.label or "rx"
			out("\e]777;notify;" + printable(title).replace(";", ",") + ";" + printable(note.body) + "\a")
		}
		if name == "title_changed" {
			named := self.named
			named[bid] = (json.from_json[Title](payload) or Title.{}).title
			self.named = named
		}
		if name == "process_changed" {
			fg := self.fg
			fg[bid] = command((json.from_json[Process](payload) or Process.{}).foreground)
			self.fg = fg
		}
		if name == "program_status_changed" {
			update :: json.from_json[Status](payload) or return
			status := self.status
			status["{bid}\n{update.id}"] = update.record.state
			self.status = status
		}
		if name == "program_status_removed" {
			removed :: json.from_json[Removed](payload) or return
			gone: []string = loop i in removed.ids do "{bid}\n{i}"
			status: [string]string = .[]
			loop state, key in self.status {
				if key !in gone do status[key] = state
			}
			self.status = status
		}
		self.draw()
	}

	relayout :: fn(mut self) ! {
		view :: self.view
		self.revision = view.revision
		size :: tty.size(1)?
		self.cols = int.(size.cols)
		self.rows = int.(size.rows)
		self.cell_w = int.(size.xpixel) / max(self.cols, 1)
		self.cell_h = int.(size.ypixel) / max(self.rows, 1)
		h :: self.rows - if self.bare do 0 else do 1
		win :: self.win()
		bid :: win.focused_block_id or ""
		if win.window_id != self.wid && self.wid != "" {
			self.last_wid = self.wid
		} else if bid != self.bid && self.bid != "" {
			last := self.last_bid
			last[win.window_id] = self.bid
			self.last_bid = last
		}
		self.wid = win.window_id
		self.bid = bid
		self.belled = loop wid in self.belled { if wid == self.wid do continue; wid }
		tiled :: (win.layers.find({ $.kind == "tiled" }) or Layer.{}).layer_id or ""
		self.areas = [Area.{ w = self.cols, h = h - if self.frames do 1 else do 0, id = tiled }]
		whole :: [0.0, 0.0, 1.0, 1.0]
		kept := []Pane.{}
		loop layer in win.layers {
			tiled :: layer.kind == "tiled"
			if win.zoomed_block_id != none || (layer.state or "") == "minimized" do continue
			bounds :: layer.bounds
			if !tiled {
				x0, y0 :: cell(bounds[0], self.cols), cell(bounds[1], h)
				x1, y1 :: cell(bounds[0] + bounds[2], self.cols), cell(bounds[1] + bounds[3], h)
				self.areas << Area.{ x = x0 + 1, y = y0 + 1, w = max(1, x1 - x0 - 2), h = max(1, y1 - y0 - 2), id = layer.layer_id or "" }
			}
			area :: if tiled do 0 else do self.areas.len() - 1
			kept << self.place(leaves(layer.layout or :null), bounds, area)
		}
		if zoomed := win.zoomed_block_id {
			kept = self.place([Leaf.{ bid = zoomed, rect = whole }], whole, 0)
		}
		loop pane in self.panes do pane.close()
		self.panes = kept
		self.refocus()
		self.landed()
		# only the active client claims, or two would trade blocks forever
		if self.owned do self.own()
		self.redraw()
	}

	win :: fn(self) Window {
		active :: self.view.active_window_id or ""
		(self.view.windows or []).find({ $.window_id == active }) or Window.{}
	}

	layer_of :: fn(self; bid: string) ?Layer {
		loop layer in self.win().layers; leaf in leaves(layer.layout or :null) {
			if leaf.bid == bid do return layer
		}
		none
	}

	place :: fn(mut self; leafs: []Leaf, bounds: []float, layer: int) []Pane {
		area :: self.areas[layer]
		loop leaf in leafs {
			pane := self.take(leaf.bid) or self.open(leaf.bid) or continue
			x, y, w, h :: rex.grid(leaf.rect, bounds, area.w, area.h)
			pane.x = area.x + x
			pane.y = area.y + y
			pane.w = w
			pane.h = h
			pane.layer = layer
			pane
		}
	}

	take :: fn(mut self; bid: string) ?Pane {
		loop i in 0..self.panes.len() {
			if self.panes[i].bid != bid do continue
			pane :: self.panes[i]
			rest := self.panes[..i]
			rest << self.panes[(i + 1)..]
			self.panes = rest
			return pane
		}
		none
	}

	open :: fn(mut self; bid: string) !Pane {
		self.streams += 1
		stream :: self.conn.data(self.sid, bid, self.streams, self.chunks)?
		Pane.{ bid = bid, id = self.streams, stream = stream, strip = strip.Strip.new(stream.nonce) }
	}

	# the server ends a stream when output piles up
	revive :: fn(mut self; i: int) {
		pane :: self.panes[i]
		stream :: pane.stream.resume(pane.read) or {
			self.panes[i].ended = true
			if !pane.painted do return
			self.reopen(i)
			return
		}
		self.panes[i].stream = stream
		self.panes[i].ended = false
	}

	reopen :: fn(mut self; i: int) {
		old :: self.panes[i]
		pane := self.open(old.bid) or return
		old.close()
		pane.x = old.x
		pane.y = old.y
		pane.w = old.w
		pane.h = old.h
		pane.layer = old.layer
		self.panes[i] = pane
	}

	pipe :: fn(mut self; bid, cmd: string) ! {
		file :: unsafe popen("RX_PANE={quote(bid)} sh -c {quote(cmd)}".cstr(), "w".cstr())
		if file.is_null() do return error("cannot run {cmd}")
		self.streams += 1
		stream :: self.aux_data(bid) or {
			discard unsafe pclose(file)
			return $
		}
		self.pipes << Pipe.{ bid = bid, id = self.streams, stream = stream, strip = strip.Strip.new(stream.nonce), file = file }
	}

	aux_data :: fn(mut self; bid: string) !rex.Stream {
		if self.aux_cid == "" {
			self.aux = rex.connect(self.sock)?
			att :: self.aux.call[Attached]("session.attach", ["session_id" = self.sid]) or {
				self.aux.close()
				return $
			}
			self.aux_cid = att.client_id
		}
		self.aux.data(self.sid, bid, self.streams, self.chunks)
	}

	unpipe :: fn(mut self; bid: string) bool {
		was :: self.pipes.len()
		self.pipes = loop pipe in self.pipes {
			if pipe.bid == bid || bid == "" {
				pipe.close()
				continue
			}
			pipe
		}
		if self.pipes.len() == 0 && self.aux_cid != "" {
			self.aux.close()
			self.aux_cid = ""
		}
		self.pipes.len() < was
	}

	close :: fn(mut self) {
		loop pane in self.panes do pane.close()
		self.panes = []
		discard self.unpipe("")
		self.chunks.close()
	}

	data :: fn(mut self; chunk: rex.Chunk) {
		loop i in 0..self.pipes.len() {
			if self.pipes[i].id != chunk.id do continue
			data :: chunk.data or {
				pipe :: self.pipes[i]
				self.pipes[i].stream = pipe.stream.resume(pipe.read) or {
					self.unpipe(pipe.bid)
					return
				}
				return
			}
			self.pipes[i].feed(data)
			return
		}
		loop i in 0..self.panes.len() {
			if self.panes[i].id != chunk.id do continue
			data :: chunk.data or {
				self.revive(i)
				return
			}
			self.panes[i].read += data.len()
			if !self.panes[i].feed(data, self.cid) do self.owned = false
			self.landed()
			return
		}
	}

	draw :: fn(mut self) {
		all := self.full
		loop pane in self.panes {
			if pane.full do all = true
		}
		hints :: self.which()
		if hints != self.hinted do all = true
		self.hinted = hints
		frame := "\e[?2026h"
		# see-through blanks don't erase, so what's under them repaints too
		if self.panes.any({ $.painted && self.opacity($.bid) < 1.0 && $.term.dirty() }) do all = true
		if all do frame += "\e[0m\e[H\e[2J"
		bar :: self.bar()
		if !self.bare && (all || bar != self.shown) {
			frame += bar
			self.shown = bar
		}
		cursor := "\e[?25l"
		over, redraw := all, all
		layer := -1
		loop i in 0..self.panes.len() {
			if self.panes[i].layer != layer {
				layer = self.panes[i].layer
				redraw = all || over && layer > 0
				if redraw do frame += self.borders(layer)
			}

			paint := self.paint(self.panes[i].bid)
			opacity :: self.opacity(self.panes[i].bid)
			if opacity < 1.0 {
				paint.tint = self.panes[i].id + 1
				if redraw do frame += ghostty.image(paint.tint, self.bg, opacity)
			}
			if self.panes[i].painted do self.panes[i].term.fit(self.cell_w, self.cell_h)
			drawn :: self.panes[i].draw(redraw, paint)

			if drawn != "" do over = true

			# a clear drops images too
			frame += drawn + self.panes[i].images(all)
			pane :: self.panes[i]
			if pane.bid != self.bid || !pane.painted do continue

			# always bracket pastes so input can tell them from typing
			keyboard :: if self.cp.bid == pane.bid do reset_modes else do pane.term.modes() + "\e[?2004h"
			modes :: keyboard + if self.mouse_off do "" else do mouse_on
			if modes != self.modes {
				frame += modes
				self.modes = modes
			}
			seq, cx, cy := pane.term.cursor(pane.x, pane.y, pane.w, pane.h)
			if self.cp.bid == pane.bid {
				seq, cx, cy = self.cp.cursor(pane.term, pane.x, pane.y, pane.w, pane.h)
			}
			cursor = seq
			if self.areas[(pane.layer + 1)..].any({ $.covers(cx, cy) }) do cursor = "\e[?25l"
		}
		if hints != "" do frame, cursor = frame + hints, "\e[?25l"
		self.full = false
		out(frame + cursor + "\e[?2026l")
	}

	paint :: fn(self; bid: string) ghostty.Paint {
		cp :: self.copy_of(bid)
		link :: if self.link.bid == bid do self.link else do Link.{}
		.{
			dim = self.dim && bid != self.bid
			marks = cp.marks, width = cells(cp.needle)
			link = link.at, reach = link.reach
		}
	}

	opacity :: fn(self; bid: string) float {
		loop layer in self.win().layers; block in layer.blocks or [] {
			if block.block_id == bid {
				return self.opacities[block.label or ""] or 1.0
			}
		}
		1.0
	}

	redraw :: fn(mut self) {
		self.full = true
		self.draw()
	}

	wake :: fn(self) time.Duration {
		if self.drag.edge do return 50.ms()
		if self.msg != "" || self.flash != "" do return 250.ms()
		if self.panes.any({ $.holding }) do return 250.ms()
		2.sec()
	}

	tick :: fn(mut self) {
		if self.msg != "" && self.msg_at.elapsed() > 3.sec() do self.msg = ""
		if self.flash != "" && self.click_at.elapsed() > 300.ms() {
			loop pane in self.panes {
				if pane.bid != self.flash || !pane.painted || self.copying(pane.bid) do continue
				pane.term.select(-1, -1, 0, 0)
			}
			self.flash = ""
			self.full = true
		}
		if self.drag.edge do self.select(self.drag, self.drag.px, self.drag.py, false)
		loop self.aux_cid != "" {
			self.aux.take(self.aux.inbox.try_recv() or break) or break
			loop { discard self.aux.queued() or break }
		}
		self.draw()
	}

	ask :: fn(mut self; prompt: string, names: []string = [], args: [string][]string = .[]) string {
		out(reset_modes)
		self.modes = ""
		line :: ask(mut self.keys, prompt, names, args)
		self.redraw()
		line
	}

	say :: fn(mut self; msg: string, bad := false) {
		self.msg = msg
		self.bad = bad
		self.msg_at = time.Instant.now()
		self.draw()
	}

	borders :: fn(self; layer: int) string {
		area :: self.areas[layer]
		cols :: self.cols
		bottom :: area.y + area.h + if self.frames && layer == 0 do 1 else do 0
		focus := Pane.{ x = -2, y = -2 }
		edge: [int]() = .[]
		buf := Buffer.{}

		loop pane in self.panes {
			if pane.layer != layer do continue

			if pane.bid == self.bid do focus = pane
			right, below :: pane.x + pane.w, pane.y + pane.h
			if right < area.x + area.w {
				loop y in pane.y..min(below + 1, bottom) do edge[y * cols + right] = ()
			}
			if below < bottom {
				loop x in pane.x..min(right + 1, area.x + area.w) do edge[below * cols + x] = ()
			}
		}

		if layer > 0 {
			solid :: self.panes.all({ $.layer != layer || self.opacity($.bid) == 1.0 })
			loop y in area.y..(area.y + area.h) {
				if solid {
					buf.write("\e[{y + 1};{area.x + 1}H\e[0m\e[{area.w}X")
				}
				edge[y * cols + area.x - 1] = ()
				edge[y * cols + area.x + area.w] = ()
			}
			loop x in (area.x - 1)..(area.x + area.w + 1) {
				edge[(area.y - 1) * cols + x] = ()
				edge[(area.y + area.h) * cols + x] = ()
			}
		}

		lines :: " │││─┘┐┤─└┌├─┴┬┼".runes() # 1 up, 2 down, 4 left, 8 right
		loop at in edge.keys {
			x, y :: at % cols, at / cols
			joins := 0

			if (at - cols) in edge do joins |= 1
			if (at + cols) in edge do joins |= 2
			if x > 0 && (at - 1) in edge do joins |= 4
			if x + 1 < cols && (at + 1) in edge do joins |= 8

			near :: x >= focus.x - 1 && x <= focus.x + focus.w && y >= focus.y - 1 && y <= focus.y + focus.h
			buf.write("\e[{y + 1};{x + 1}H" + (if near do "\e[32m" else do "\e[39m") + lines[joins].str())
		}

		loop pane in self.panes {
			if !self.frames do break
			title :: self.pane_title(pane) + marks[urgency(self.state(pane.bid))]
			if pane.layer != layer || title == "" || pane.w < 5 do continue

			color :: if pane.bid == self.bid do "\e[1;32m" else do "\e[0;39m"
			buf.write("\e[{pane.y + pane.h + 1};{pane.x + 2}H" + color + " " + fit(printable(title), pane.w - 4) + " \e[0m")
		}
		buf.str()
	}

	bar :: fn(mut self) string {
		label :: " " + (self.view.label or "") + " "
		pill :: if self.typed.len() > 0 do "\e[30;43m" else do "\e[30;44m"
		line := "\e[{self.rows};1H\e[?7l\e[0m\e[2K" + pill + label
		plain := label
		modes: []string = loop mode in self.modes_on do mode
		if self.cp.bid != "" do modes << "copy"
		if self.marked != "" do modes << "marked"
		if self.bid in self.grouped do modes << "group {self.grouped.len()}"
		if self.readonly do modes << "ro"
		if self.recording do modes << "rec"
		if self.pipes.any({ $.bid == self.bid }) do modes << "piped"
		if self.peers > 0 do modes << "+{self.peers} attached"
		loop mode in modes {
			line += "\e[0;1;35m {mode}"
			plain += " {mode}"
		}
		line += "\e[0m "
		plain += " "
		active :: self.view.active_window_id or ""
		wins :: self.view.windows or []
		tabs := []int.{}
		loop win, i in wins {
			tabs << cells(plain)
			wid :: win.window_id
			name :: self.tab_name(win)
			tab :: "{i + 1}" + if name != "" do " " + name else do ""

			flags := ""
			if win.zoomed_block_id != none do flags += " Z"
			if minimized(win) do flags += " M"
			if wid in self.synced do flags += " S"
			if wid in self.tiling do flags += " T"
			if wid in self.belled do flags += " !"
			flags += marks[urgency(self.win_state(win))]

			current :: wid == active
			line += (if current do "\e[0;30;42m " else do "\e[0m ") + tab + (if current do "" else do "\e[33m") + flags + " "
			plain += " " + tab + flags + " "
		}
		tabs << cells(plain)
		self.tabs = tabs
		clock :: " " + time.Time.now().format("%H:%M") + " "
		left :: cells(plain) + 1
		end := self.cols
		if left + clock.len() <= self.cols do end -= clock.len() + 1
		right := "\e[0m"
		text := ""
		if pane := self.focused(), pane.painted do text = pane.term.title()
		if self.msg != "" {
			right = if self.bad do "\e[0;1;31m" else do "\e[0;1m"
			text = self.msg
		}
		width :: cells(text)
		col :: max(left + 1, end - width + 1)
		if text != "" do line += "\e[{self.rows};{col}H" + right + text
		if col + width - 1 > end do line += "\e[{self.rows};{end}H…"
		if end < self.cols do line += "\e[{self.rows};{end + 1}H\e[0m \e[30;44m" + clock
		line + "\e[0m\e[?7h"
	}

	pane_title :: fn(self; pane: Pane) string {
		label :: self.labels[pane.bid] or ""
		if label != "" do return label
		title :: if pane.painted do pane.term.title() else do ""
		if title != "" do title else do self.fg[pane.bid] or ""
	}

	tab_name :: fn(self; win: Window) string {
		if !default_label(win) do return win.label or ""

		bid :: win.focused_block_id or ""
		cmd, title :: self.fg[bid] or "", printable(self.named[bid] or "")

		# like #{b:pane_current_path}
		title :: if title.starts_with("/") || title.starts_with("~") {
			fs.Path.(title).name()
		} else {
			title
		}

		match {
			title == "" || title == cmd => cmd,
			cmd == "" => cut(title, 24),
			_ => cmd + ": " + cut(title, 24),
		}
	}

	# TODO: a mode's exclusive and blocked keys
	hints :: fn(self) (rows: [](string, string), groups: int) {
		depth :: self.typed.len()
		mode :: self.modes_on.last() or ""
		bindings: []keymap.Binding = loop binding in self.km.bindings {
			scope :: binding.mode or ""
			if binding.keys.len() <= depth || binding.action !in self.can do continue
			if scope !in [mode, ""] || depth == 0 && scope != mode do continue
			if !keymap.matches(binding.keys, self.typed) do continue
			binding
		}
		keymap.hint_rows(bindings, depth, self.titles)
	}

	which :: fn(self) string {
		if self.typed.len() == 0 && self.modes_on.len() == 0 do return ""

		hints, groups :: self.hints()
		if hints.len() == 0 do return ""

		bottom :: self.rows - if self.bare do 0 else do 1
		if bottom < 3 do return ""

		rows, w := []string.{}, 0
		loop cap in [24, 16, 12] {
			all := false
			loop ncols in 1..=hints.len() {
				nrows :: min((hints.len() + ncols - 1) / ncols, bottom - 2)
				if (ncols - 1) * nrows >= hints.len() do continue

				shown := hints
				room :: ncols * nrows
				if hints.len() > room {
					shown = hints[..(room - 1)]
					shown << ("…", "{hints.len() - room + 1} more")
				}

				key_widths, title_widths := []int.{}, []int.{}
				loop (key, title), i in shown {
					if i % nrows == 0 {
						key_widths << 0
						title_widths << 0
					}
					col :: i / nrows
					key_widths[col] = max(key_widths[col], cells(key))
					title_widths[col] = max(title_widths[col], min(cells(title), cap))
				}

				width := 3 * (key_widths.len() - 1)
				loop col in 0..key_widths.len() {
					width += key_widths[col] + 1 + title_widths[col]
				}
				if ncols > 1 && width > self.cols - 4 do continue

				w = min(width, self.cols - 4)
				rows = loop row in 0..nrows {
					cols :: loop col in 0..key_widths.len() {
						at :: col * nrows + row
						key, title :: if at < shown.len() do shown[at] else do ("", "")
						cell :: pad(key, key_widths[col]) + " " + pad(cut(title, title_widths[col]), title_widths[col])

						if at < groups {
							"\e[38;5;220m" + cell + "\e[39m"
						} else do cell
					}
					cols |> $.join(" │ ")
				}
				all = shown.len() == hints.len()
			}
			if all do break
		}

		title :: if self.typed.len() > 0 {
			self.typed.map({ $[0] }) |> $.join(" ")
		} else {
			self.modes_on.last() or ""
		}
		box(0, bottom - rows.len() - 2, w + 2, title, rows)
	}

	bell :: fn(mut self; bid: string) {
		out("\a")
		loop win in self.view.windows or [] {
			if win.window_id == self.wid || win.window_id in self.belled do continue
			loop layer in win.layers; leaf in leaves(layer.layout or :null) {
				if leaf.bid == bid do self.belled << win.window_id
			}
		}
		self.draw()
	}

	event :: fn(mut self; raw: Json) !bool {
		outer :: json.from_json[Outer](raw) or return false
		if outer.type == "session_destroyed" do return true
		if outer.type == "keymap_changed" && (outer.payload.hash or "") != self.hash {
			self.load_keymap()?
		}
		if outer.type == "client_perform_requested" do return self.requested(outer.payload)
		ev :: outer.payload.event or return false
		change :: ev.payload
		if ev.type == "block_event" do self.block_event(change)
		if ev.type in ["client_connected", "client_disconnected"] {
			self.peers = (self.others() or []).len()
			self.draw()
		}
		if ev.type == "block_owner_changed" && (change.owner or "") != self.cid {
			if self.panes.any({ $.bid == (change.block_id or "") }) do self.owned = false
		}
		if ev.type != "session_view_changed" || (change.revision or 0) <= self.revision do return false
		view :: self.call[View]("session.view") or return false # killed, session_destroyed follows
		self.apply(view)?
		self.unstrand() or () # races other clients

		# Rex keeps an empty session, tmux doesn't
		if (view.windows or []).len() == 0 do discard self.call[Ok]("session.destroy") or Ok.{}
		self.panes.len() == 0
	}

	input :: fn(mut self; data: string) !bool {
		if !self.owned do self.own()
		pass := ""
		self.keys.unread += data
		loop self.keys.unread != "" {
			buf :: self.keys.unread
			_, fin, seq_len := keys.csi(buf)
			if buf.starts_with("\e[<") && (fin == 'M' || fin == 'm') {
				self.keys.unread = buf[seq_len..]
				# a resize is a round trip, only the last motion needs one
				if self.drag.resizing() && moving(buf) && moving(self.keys.unread) do continue
				pass += self.mouse(buf[..seq_len])?
				if self.detach do return true
				continue
			}

			if buf.starts_with("\e]11;") {
				body :: buf[5..].split("\e\\")
				if body.len() < 2 do break
				self.bg = body[0]
				self.keys.unread = buf[(body[0].len() + 7)..]
				continue
			}

			if buf.starts_with("\e[200~") {
				# a paste skips the keymap, or its newlines would be ctrl+j
				body :: buf[6..].split("\e[201~")
				if body.len() < 2 do break
				used :: body[0].len() + 12
				self.keys.unread = buf[used..]
				pane :: self.focused() or Pane.{}
				pass += if pane.painted && pane.term.mode(2004) do buf[..used] else do body[0]
				continue
			}

			parsed, used := keys.key_of(buf)
			self.keys.unread = buf[used..]
			if self.recording {
				if self.typed.len() == 0 do self.mark = self.tape.len()
				self.tape += buf[..used]
			}
			key :: parsed or {
				pass += buf[..used]
				continue
			}

			if key.action != "press" {
				if key.code in self.eaten {
					if key.action == "release" do self.eaten = self.eaten.filter({ $ != key.code })
				} else do pass += buf[..used]
				continue
			}

			typed := self.typed
			typed << key.names
			hit, drop := keymap.resolve(self.km, typed, self.can, self.modes_on.last() or "")
			hit :: hit or {
				copying :: self.cp.bid != ""
				if self.typed.len() == 0 && copying do self.copy_key(key)
				if self.typed.len() == 0 && !drop && !copying do pass += buf[..used] else do self.eat(key)
				self.typed = []
				continue
			}

			self.eat(key)
			if hit.keys.len() > typed.len() {
				self.typed = typed
				continue
			}

			self.typed = []
			if self.recording && hit.action.starts_with("macro.") do self.tape = self.tape[..self.mark]
			self.write(pass)?
			pass = ""
			if self.perform(hit, key) or { self.say($.message(), true); false } do return true
		}

		self.write(pass)?
		if self.bar() != self.shown || self.which() != self.hinted do self.draw()
		false
	}

	copy_key :: fn(mut self; key: keys.Key) {
		pane :: self.focused() or return
		name := if key.text != "" do key.text else do key.names[0]
		if name == "/" || name == "?" {
			needle :: self.ask(name)
			if needle == "" do return
			self.cp.needle = needle
			self.cp.back = name == "?"
			name = "n"
		}
		yank, done := self.cp.key(pane.term, name)
		if yank != "" do self.clip(yank, name == "O")
		if done do self.stop_copy()
		self.redraw()
	}

	clip :: fn(mut self; text: string, open := false) {
		kept := [text]
		loop old in self.buffers {
			if old != text && kept.len() < 20 do kept << old
		}
		self.buffers = kept
		if open do discard os.sh("printf %s {quote(text)} | xargs xdg-open >/dev/null 2>&1 &")
		else do out("\e]52;c;{base64.encode(text)}\a")
	}

	stop_copy :: fn(mut self) {
		loop pane in self.panes {
			if pane.bid != self.cp.bid || !pane.painted do continue
			pane.term.select(-1, -1, 0, 0)
			discard pane.term.scroll(0)
		}
		self.cp = Copy.{}
		self.full = true
	}

	refocus :: fn(mut self) {
		parked := self.parked
		if self.cp.bid != "" do parked << self.cp
		self.cp = Copy.{}
		shown: []string = loop pane in self.panes do pane.bid
		self.parked = loop mode in parked {
			if mode.bid !in shown do continue
			if mode.bid == self.bid {
				self.cp = mode
				continue
			}
			mode
		}
	}

	landed :: fn(mut self) {
		if self.land.bid == "" || self.land.bid != self.bid do return
		pane :: self.focused() or return
		if !pane.painted do return
		_, _, total := pane.term.viewport()
		mode := Copy.{ bid = pane.bid, x = pane.term.cols() - 1, y = total - 1, needle = self.land.needle, back = true }
		discard mode.key(pane.term, "n")
		mode.needle = self.land.sel
		mode.marks = pane.term.find(mode.needle)
		mode.back = false
		self.cp = mode
		self.land = Copy.{}
		self.redraw()
	}

	copying :: fn(self; bid: string) bool {
		self.copy_of(bid).bid != ""
	}

	copy_of :: fn(self; bid: string) Copy {
		if self.cp.bid == bid do return self.cp
		self.parked.find({ $.bid == bid }) or Copy.{}
	}

	focused :: fn(self) ?Pane {
		self.panes.find({ $.bid == self.bid })
	}

	painted :: fn(self) !Pane {
		pane :: self.focused() or return error("no pane")
		if !pane.painted do return error("no pane")
		pane
	}

	eat :: fn(mut self; key: keys.Key) {
		if key.code !in self.eaten do self.eaten << key.code
	}

	mouse :: fn(mut self; seq: string) !string {
		button, x, y, up :: sgr(seq)
		if button < 0 do return ""
		if self.drag.kind != "" && (up || button & 32 != 0) do return self.dragged(button, x, y, up)
		self.drag = Drag.{} # lost the release
		if button & 35 == 35 do self.hover(x, y)
		press :: !up && button & 96 == 0
		left :: press && button & 3 == 0
		if y == self.rows - 1 && !self.bare {
			if button & 98 == 64 do discard self.act(if button & 1 == 0 do "tab.previous" else do "tab.next", none)?
			wid :: self.tab_at(x)
			if press && button & 3 == 1 && wid != "" do self.ok("session.close_window", ["window_id" = wid])?
			if left && wid != "" {
				discard self.count("tab " + wid)
				self.ok("session.focus_window", ["window_id" = wid])?
				self.drag = Drag.{ kind = "tab", id = wid }
			}
			if left && self.on_pill(x) do self.drag = Drag.{ kind = "pill" }
			if press && button & 3 == 2 && (wid != "" || self.on_pill(x)) {
				if wid != "" {
					self.ok("session.focus_window", ["window_id" = wid])?
					self.view.active_window_id = wid # the view lags, the menu needs it now
				}
				title, items :: if wid != "" do ("Tab", tab_items()) else do ("Session", session_items())
				self.detach = self.menu(x, y, title, items) or { self.say($.message(), true); false }
			}
			return ""
		}
		top := 0
		loop i in 1..self.areas.len() {
			if self.areas[i].covers(x, y) do top = i
		}
		area :: self.areas[top]
		if left && top > 0 && (x < area.x || x >= area.x + area.w || y < area.y || y >= area.y + area.h) {
			kind :: if x == area.x + area.w && y == area.y + area.h do "corner" else do "float"
			if layer := self.win().layers.find({ ($.layer_id or "") == area.id }) {
				self.drag = Drag.{ kind = kind, x = x, y = y, id = area.id, bounds = layer.bounds }
			}
			to := ""
			loop pane in self.panes {
				if pane.layer == top && (to == "" || pane.bid == self.bid) do to = pane.bid
			}
			if to != "" && to != self.bid do self.focus(to)?
			return ""
		}
		if left && self.win().zoomed_block_id == none {
			loop layer in self.win().layers {
				if (layer.layer_id or "") != area.id do continue
				node :: border(layer.layout or :null, x, y, area, layer.bounds) or continue
				self.drag = Drag.{ kind = "split", node = node, area = area, bounds = layer.bounds }
				return ""
			}
		}
		loop pane in self.panes {
			if pane.layer != top || x < pane.x || x >= pane.x + pane.w || y < pane.y || y >= pane.y + pane.h {
				continue
			}
			if left && button & 16 != 0 && pane.painted {
				start, _, _ := pane.term.viewport()
				url, _, _ :: link_at(pane.term, x - pane.x, start + y - pane.y)
				if url != "" {
					browse(url)
					self.drag = Drag.{ kind = "eat" }
					return ""
				}
			}
			ev :: if pane.painted && !self.copying(pane.bid) {
				report(pane.term, button, x - pane.x, y - pane.y, up)
			} else {
				""
			}
			if ev == "" && button & 98 == 64 && pane.painted && pane.term.scroll(if button & 1 == 0 do -3 else do 3) {
				self.redraw()
				return ""
			}
			if ev == "" && press && pane.painted do self.pressed(pane, button, x - pane.x, y - pane.y)
			if pane.bid == self.bid {
				if press && ev != "" do self.drag = Drag.{ kind = "program", id = pane.bid }
				return ev
			}
			if button & 96 == 64 && ev != "" do self.term(pane.bid, "write", ["data" = ev])?
			if press {
				if self.drag.kind == "" do self.drag = Drag.{ kind = "eat" }
				self.focus(pane.bid)?
			}
			return ""
		}
		""
	}

	hover :: fn(mut self; x, y: int) {
		link := Link.{}
		loop pane in self.panes {
			if !pane.painted || x < pane.x || x >= pane.x + pane.w || y < pane.y || y >= pane.y + pane.h {
				continue
			}

			top, _, _ := pane.term.viewport()
			row :: top + y - pane.y
			url, from, to :: link_at(pane.term, x - pane.x, row)
			link = if url == "" {
				Link.{}
			} else {
				Link.{
					bid = pane.bid,
					at = row * pane.term.cols() + from,
					reach = to - from,
				}
			}
		}
		if link.bid == self.link.bid && link.at == self.link.at do return

		self.link = link
		self.redraw()
	}

	pressed :: fn(mut self; pane: Pane, button, x, y: int) {
		if button & 3 == 1 do self.paste(pane) or { self.say($.message(), true) }
		if button & 3 == 2 {
			if pane.bid != self.bid {
				self.focus(pane.bid) or return
				self.bid = pane.bid
			}
			self.detach = self.menu(pane.x + x, pane.y + y, "Pane", pane_items()) or {
				self.say($.message(), true)
				false
			}
		}
		if button & 3 != 0 do return

		discard self.count("{pane.bid} {x} {y}")
		top, _, _ := pane.term.viewport()
		row :: top + y
		if self.clicks == 1 {
			self.drag = Drag.{ kind = "select", x = x, y = row, id = pane.bid, block = button & 8 != 0 }
			return
		}

		ax, bx := 0, pane.term.cols() - 1
		if self.clicks == 2 {
			ax, bx = word(pane.term, x, row)
		}

		pane.term.select(ax, row, bx, row)
		self.flash = pane.bid
		self.full = true
		self.clip(pane.term.copy(ax, row, bx, row))
		self.say("copied")
	}

	menu :: fn(mut self; x, y: int, title: string, items: []Item) !bool {
		w :: 16
		x0, y0 :: clamp(x, 0, self.cols - w - 2), clamp(y, 0, self.rows - items.len() - 3)
		rows: []string = loop item in items do pad(item.label, w - 3) + item.key
		paint :: fn(on: int) () { out("\e[?2026h" + box(x0, y0, w, title, rows, on) + "\e[?25l\e[?2026l") }
		out(reset_modes + "\e[?1002h\e[?1006h")
		paint(-1)
		self.modes = ""
		on, pick := -1, -1
		armed := false
		loop {
			if self.keys.unread == "" do self.keys.unread = self.keys.chan.recv() or break
			at := on
			if seq :: self.keys.unread; seq.starts_with("\e[<") {
				_, _, used := keys.csi(seq)
				if used == 0 do break
				button, mx, my, up :: sgr(seq[..used])
				self.keys.unread = seq[used..]
				if button & 64 != 0 do continue
				i :: my - y0 - 1
				at = if mx > x0 && mx <= x0 + w && i >= 0 && i < items.len() do i else do -1
				if !up && button & 32 == 0 {
					if at < 0 {
						self.drag = Drag.{ kind = "eat" } # a click outside closes it
						break
					}
					armed = true
				}
				if mx != x || my != y do armed = true
				if up && armed {
					pick = at
					break
				}
			} else {
				key :: self.keys.next() or break
				if key.action != "press" do continue
				if key.names[0] == "down" {
					at = (on + 1) % items.len()
				} else if key.names[0] == "up" {
					at = if on <= 0 do items.len() - 1 else do on - 1
				} else if key.names[0] == "enter" && on >= 0 {
					pick = on
					break
				} else {
					loop i in 0..items.len() {
						if items[i].key == key.text do pick = i
					}
					break
				}
			}
			if at != on {
				paint(at)
				on = at
			}
		}
		self.redraw()
		if pick < 0 do return false
		self.act(items[pick].action, Json.(items[pick].args))
	}

	number :: fn(mut self) ! {
		# plain keys, or the digit's release reaches the program
		frame := reset_modes + "\e[?2026h"
		self.modes = ""
		loop i in 0..min(self.panes.len(), 9) {
			pane :: self.panes[i]
			color :: if pane.bid == self.bid do "\e[30;42m" else do "\e[30;44m"
			frame += "\e[{pane.y + pane.h / 2 + 1};{pane.x + max(pane.w / 2 - 1, 0) + 1}H" + color + " {i + 1} \e[0m"
		}
		out(frame + "\e[?25l\e[?2026l")
		key :: self.keys.next()
		self.redraw()
		i :: int.try_from((key or return ()).text) or return ()
		if i >= 1 && i <= min(self.panes.len(), 9) do self.focus(self.panes[i - 1].bid)?
	}

	clock :: fn(mut self) {
		out(reset_modes)
		self.modes = ""
		loop {
			pane :: self.focused() or break
			now :: time.Time.now().format("%H:%M")
			rows :: if pane.w >= 34 && pane.h >= 5 do big(now) else do [now]
			frame := "\e[?2026h\e[0m"
			loop y in pane.y..(pane.y + pane.h) do frame += "\e[{y + 1};{pane.x + 1}H\e[{pane.w}X"
			y0, x0 :: pane.y + (pane.h - rows.len()) / 2, pane.x + max(pane.w - cells(rows[0]), 0) / 2
			loop i in 0..rows.len() do frame += "\e[{y0 + i + 1};{x0 + 1}H\e[34m" + fit(rows[i], pane.w)
			out(frame + "\e[0m\e[?25l\e[?2026l")
			if self.keys.unread == "" {
				sync.select! {
					data := <-self.keys.chan => {
						self.keys.unread = data or " "
						()
					},
					sync.after(1.sec()) => {},
				}
			}
			if self.keys.unread == "" do continue
			discard self.keys.next()
			break
		}
		self.redraw()
	}

	quick :: fn(mut self) ! {
		pane :: self.painted()?
		top, _, _ := pane.term.viewport()
		found := []Hit.{}
		loop y in 0..pane.h; hit in hits(pane.term, top + y) {
			if hit.x < pane.w do found << hit
		}
		alphabet :: "asdfjklghqweruiopzxcvbnmty"
		base :: alphabet.len()
		texts := []string.{}
		loop i in 0..found.len() {
			hit :: found[found.len() - 1 - i]
			if hit.text !in texts && texts.len() < base * base do texts << hit.text
		}
		if texts.len() == 0 do return error("nothing to copy")
		two :: texts.len() > base
		label :: fn(i: int) string {
			if two {
				alphabet[(i / base)..(i / base + 1)] + alphabet[(i % base)..(i % base + 1)]
			} else {
				alphabet[i..(i + 1)]
			}
		}
		frame := reset_modes + "\e[?2026h"
		self.modes = ""
		loop hit in found {
			i :: texts.index(hit.text) or continue
			frame += "\e[{pane.y + hit.y - top + 1};{pane.x + hit.x + 1}H\e[30;43m" + label(i) + "\e[0m"
		}
		out(frame + "\e[?25l\e[?2026l")
		typed, pick, shifted := "", -1, false
		loop {
			key :: self.keys.next() or break
			if key.action != "press" do continue
			char :: key.text.lower()
			if char.len() != 1 || !alphabet.contains(char) do break
			shifted = shifted || char != key.text
			typed += char
			if typed.len() < label(0).len() do continue
			loop i in 0..texts.len() {
				if label(i) == typed do pick = i
			}
			break
		}
		self.redraw()
		if pick < 0 do return ()
		self.clip(texts[pick])
		if shifted do self.paste(pane)? else do self.say("copied")
	}

	palette :: fn(mut self) !bool {
		all := []keymap.Action.{}
		loop action in keymap.declared()? do all << action
		loop action in self.km.actions or [] do all << action
		all = loop action in all { if (action.title or "") == "" || action.name !in self.can do continue; action }
		i :: self.choose(self.titles["client.palette"] or "", loop action in all do action.title or "")
		if i < 0 do return false
		action :: all[i]
		args: Obj = []
		loop arg in (action.args or keymap.Schema.{}).required or [] {
			answer :: self.ask("{action.title or action.name} {arg}: ")
			if answer == "" do return false
			args[arg] = value(answer)
		}
		self.perform(keymap.Binding.{ action = action.name, args = Json.(args) }, keys.Key.{})
	}

	choose :: fn(mut self; title: string, items: []string, preview: ?fn(int) []string = none) int {
		self.modes = ""
		list := List.{ title = title, items = items }
		picked, _ :: list.choose(mut self.keys, preview = preview)
		self.redraw()
		picked
	}

	count :: fn(mut self; here: string) int {
		self.clicks = if here == self.click && self.click_at.elapsed() < 400.ms() do self.clicks % 3 + 1 else do 1
		self.click = here
		self.click_at = time.Instant.now()
		self.clicks
	}

	on_pill :: fn(self; x: int) bool {
		x < cells(self.view.label or "") + 2
	}

	paste :: fn(mut self; pane: Pane, i := 0) ! {
		if i >= self.buffers.len() do return error("nothing copied")
		text :: self.buffers[i]
		data :: if pane.painted && pane.term.mode(2004) do "\e[200~{text}\e[201~" else do text
		if pane.bid != self.bid do return self.term(pane.bid, "write", ["data" = data])
		self.write(data)
	}

	dragged :: fn(mut self; button, x, y: int, up: bool) !string {
		drag :: self.drag
		if up do self.drag = Drag.{}
		if drag.kind == "pill" && up && y == self.rows - 1 && self.on_pill(x) {
			self.detach = self.act("session.choose", none)?
		}
		match drag.kind {
			"split" => {
				split :: drag.node.split or return ""
				rect, area, bounds :: drag.node.rect, drag.area, drag.bounds
				# +1, the border is the cell before the after side
				fx :: bounds[0] + float.(x + 1 - area.x) / float.(area.w) * bounds[2]
				fy :: bounds[1] + float.(y + 1 - area.y) / float.(area.h) * bounds[3]
				ratio :: if split.direction == "horizontal" do (fx - rect[0]) / rect[2] else do (fy - rect[1]) / rect[3]
				if !up do self.ratio(split, clamp(ratio, 0.05, 0.95))?
			},
			"float", "corner" => {
				bounds :: drag.bounds
				dx, dy :: float.(x - drag.x) / float.(self.cols), float.(y - drag.y) / float.(self.areas[0].h)
				left, top, w, h :: bounds[0], bounds[1], bounds[2], bounds[3]
				moved: json.Arr = [clamp(left + dx, 0.0, 1.0 - w), clamp(top + dy, 0.0, 1.0 - h), w, h]
				sized: json.Arr = [left, top, clamp(w + dx, 0.05, 1.0 - left), clamp(h + dy, 0.05, 1.0 - top)]
				to :: if drag.kind == "corner" do sized else do moved
				if !up do self.ok("session.resize_layer", ["layer_id" = drag.id, "bounds" = to])?
			},
			"tab" => {
				if up && y == self.rows - 1 {
					to :: self.tab_at(x)
					if to == drag.id && self.clicks == 2 do self.rename_tab(to)? else do self.drop_tab(drag.id, to)?
				}
			},
			"select" => self.select(drag, x, y, up),
			"program" => {
				pane :: self.focused() or return ""
				if pane.bid == drag.id && pane.painted {
					return report(pane.term, button, clamp(x - pane.x, 0, pane.w - 1), clamp(y - pane.y, 0, pane.h - 1), up)
				}
			},
		}

		""
	}

	select :: fn(mut self; drag: Drag, x, y: int, up: bool) {
		self.drag.edge = false
		pane :: self.panes.find({ $.bid == drag.id }) or return
		if !pane.painted do return
		if up {
			if drag.moved && self.cp.bid == pane.bid {
				self.clip(self.cp.copy(pane.term))
				self.stop_copy()
				self.say("copied")
			}
			if !drag.moved {
				url, _, _ :: link_at(pane.term, drag.x, drag.y)
				if url != "" do browse(url)
			}
			return
		}
		if !drag.moved {
			self.drag.moved = true
			self.parked = loop mode in self.parked { if mode.bid == pane.bid do continue; mode }
			if self.cp.bid != "" && self.cp.bid != pane.bid do self.parked << self.cp
			self.cp = Copy.{ bid = pane.bid, x = drag.x, y = drag.y, ax = drag.x, ay = drag.y, sel = if drag.block do "ctrl+v" else do "v" }
		}
		top, _, total := pane.term.viewport()
		row := y - pane.y
		if row <= 0 do row -= 1
		if row >= pane.h - 1 do row += 1
		self.drag.px = x
		self.drag.py = y
		self.drag.edge = row < 0 && top > 0 || row >= pane.h && top + pane.h < total
		self.cp.go(pane.term, x - pane.x, top + row)
		ax, ay, bx, by := self.cp.ends(pane.term)
		pane.term.select(ax, ay, bx, by, self.cp.sel == "ctrl+v")
		self.redraw()
	}

	tab_at :: fn(self; x: int) string {
		wins :: self.view.windows or []
		loop win, i in wins {
			if i + 1 < self.tabs.len() && x >= self.tabs[i] && x < self.tabs[i + 1] do return win.window_id
		}
		""
	}

	drop_tab :: fn(mut self; wid, to: string) ! {
		wins :: self.view.windows or []
		i, j := -1, -1
		loop k in 0..wins.len() {
			if wins[k].window_id == wid do i = k
			if wins[k].window_id == to do j = k
		}
		if i < 0 || j < 0 || i == j do return ()
		args: Obj = ["window_id" = wid]
		if j < i {
			args["before_window_id"] = to
		} else if j + 1 < wins.len() {
			args["before_window_id"] = wins[j + 1].window_id
		}
		self.ok("session.move_window", args)?
	}

	perform :: fn(mut self; binding: keymap.Binding, key: keys.Key) !bool {
		if binding.action == "client.key.forward" && binding.keys.len() > 0 {
			prefix: []Json = loop name in binding.keys[..(binding.keys.len() - 1)] do Json.(name)
			self.ok("client.key", ["block_id" = self.bid, "key" = key.ev, "prefix" = prefix])?
			return false
		}
		if binding.action in self.ours do return self.act(binding.action, binding.args)
		done :: self.call[Done]("client.action", [
			"action" = binding.action, "args" = binding.args or :null, "origin" = "key", "block_id" = self.bid,
		])?
		loop action in done.client_actions or [] {
			if action.action in self.ours && self.act(action.action, action.args)? do return true
		}
		false
	}

	cycle :: fn(mut self; by: int) !bool {
		sessions :: self.conn.call[Sessions]("session.list")?.sessions
		if sessions.len() < 2 do return false
		i := 0
		loop session, j in sessions {
			if session.session_id == self.sid do i = j
		}
		self.next = sessions[(i + by + sessions.len()) % sessions.len()].label
		true
	}

	others :: fn(mut self) ![]Peer {
		mine :: [self.cid, self.aux_cid]
		peers :: self.call[Clients]("session.list_clients")?.clients or []
		peers.filter({ ($.client_id or "") !in mine })
	}

	kick :: fn(mut self; peer: Peer) ! {
		self.ok("client.perform", ["client_id" = peer.client_id or "", "action" = "detach", "timeout_ms" = 3000.0])?
	}

	act :: fn(mut self; name: string, args: ?Json) !bool {
		empty: Obj = []
		opts :: json.from_json[keymap.Args](args or { empty }) or keymap.Args.{}
		dir :: opts.direction or "right"
		title :: self.titles[name] or { name }

		match name {
			"detach" => return true,
			"session.choose" => {
				self.choose = true
				return true
			},
			"session.new" => {
				self.next = self.ask("new session: ")
				return self.next != ""
			},
			"session.warp" => {
				label :: self.ask("warp: ")
				if label == "" do return false
				self.dir = zoxide(label)?
				self.next = label
				return true
			},
			"session.rename" => {
				label :: self.ask("rename session: ")
				if label != "" do self.ok("session.set_label", ["label" = label])?
			},
			"session.close" => self.ok("session.destroy")?,
			"session.select" => {
				id :: opts.session_id or return error("session.select needs a session_id")
				if wid := opts.window_id {
					discard manage(self.sock, "session.focus_window", ["session_id" = id, "window_id" = wid])?
				}
				if id == self.sid do return false
				self.next = id
				return true
			},
			"session.last" => {
				sessions :: self.conn.call[Sessions]("session.list")?.sessions
				if !sessions.any({ $.session_id == self.prev }) do return error("no last session")
				self.next = self.prev
				return true
			},
			"session.goto" => {
				sessions :: self.conn.call[Sessions]("session.list")?.sessions
				index :: opts.index or return error("session.goto needs an index")
				at :: if index < 0 do sessions.len() + index else do index - 1
				if at < 0 || at >= sessions.len() do return error("no session {index}")
				if sessions[at].session_id == self.sid do return false
				self.next = sessions[at].session_id
				return true
			},
			"session.next" => return self.cycle(1)?,
			"session.previous" => return self.cycle(-1)?,
			"pane.split" => {
				pane :: self.focused() or Pane.{}
				# the longer side, a cell is about twice as tall as wide
				towards :: opts.direction or if pane.w >= 2 * pane.h do "right" else do "down"
				shell :: rex.shell(self.here(), runs(opts.command or ""))
				self.ok("session.new_split", ["direction" = axis(towards), "side" = side(towards), "layout" = shell, "focus" = true])?
			},
			"pane.break" => {
				# Rex won't open an empty window, so a throwaway block holds the place
				tab :: self.call[NewWindow]("session.new_window", ["layout" = rex.shell()])?
				self.ok("session.move_block", ["block_id" = self.bid, "anchor_block_id" = tab.block_ids[0]])?
				self.ok("block.close", ["block_id" = tab.block_ids[0]])?
			},
			"pane.mark" => {
				self.marked = if self.marked == self.bid do "" else do self.bid
				self.redraw()
			},
			"pane.join" => {
				if self.marked == "" || self.marked == self.bid do return error("no marked pane")
				self.ok("session.move_block", ["block_id" = self.marked, "anchor_block_id" = self.bid, "direction" = axis(dir), "side" = side(dir)])?
				self.marked = ""
				self.draw()
			},
			"pane.rotate" => {
				layer :: self.layer_of(self.bid) or return error("no pane")
				bids: []string = loop leaf in leaves(layer.layout or :null) do leaf.bid
				loop (from, to) in rotation(bids, dir == "up") {
					self.ok("session.swap_blocks", ["block_id" = from, "other_block_id" = to])?
				}
			},
			"pane.edit" => {
				pane :: self.painted()?
				_, _, total := pane.term.viewport()
				self.edits += 1
				path :: (os.env("XDG_RUNTIME_DIR") or "/tmp") + "/rx-{os.pid()}-{self.edits}.txt"
				fs.write(fs.Path.(path), pane.term.copy(0, 0, pane.term.cols() - 1, total - 1) + "\n")?
				quoted :: quote(path)
				self.pop("${{EDITOR:-vi}} {quoted}")?
				# can't rm from the pane, closing it kills everything in it. 5s is plenty for the editor
				discard os.sh("(sleep 5; rm -f {quoted}) >/dev/null 2>&1 &")
			},
			"pane.close" => self.ok("block.close", ["block_id" = self.bid])?,
			"pane.zoom" => self.ok("session.zoom_block")?,
			"pane.resize" => self.resize(dir, opts.cells or 2)?,
			"layer.move" => {
				layer :: self.layer_of(self.bid) or return error("no pane")
				if layer.kind == "tiled" do return error("not a floating layer")
				self.ok("session.resize_layer", ["layer_id" = layer.layer_id or "", "bounds" = shift(layer.bounds, dir, self.frac(dir, opts.cells or 2))])?
			},
			"pane.swap" => {
				other := self.marked
				if opts.direction != none || other == "" {
					other = (self.beside(dir) or return error("no pane {dir}")).bid
				}
				self.ok("session.swap_blocks", ["block_id" = self.bid, "other_block_id" = other])?
			},
			"layer.float" => self.float()?,
			"pane.copy" => {
				pane :: self.painted()?
				top, rows, _ := pane.term.viewport()
				_, cx, cy := pane.term.cursor(0, 0, pane.w, pane.h)
				self.cp = Copy.{ bid = pane.bid, x = max(cx, 0), y = top + if cy < 0 do rows - 1 else do cy }
				self.redraw()
			},
			"pane.paste" => self.paste(self.focused() or return error("no pane"))?,
			"buffer.choose" => {
				if self.buffers.len() == 0 do return error("nothing copied")
				i :: self.choose(title, loop buf in self.buffers do buf.replace("\n", "↵").replace("\t", " "))
				if i >= 0 do self.paste(self.focused() or return error("no pane"), i)?
			},
			"client.choose" => {
				peers :: self.others()?
				if peers.len() == 0 do return error("no other client")
				i :: self.choose(title, loop peer in peers do describe(peer))
				if i >= 0 do self.kick(peers[i])?
			},
			"client.detach_others" => {
				loop peer in self.others()? do self.kick(peer) or {}
			},
			"client.config.reload" => discard self.conn.call[Ok]("server.config_reload")?,
			"client.msg" => self.say(opts.text or return error("client.msg needs text")),
			"client.prompt" => {
				typed :: words(self.ask(": ", self.can.keys, self.arg_words))
				if typed.len() == 0 do return false
				args: Obj = []
				loop kv in typed[1..] {
					pair :: kv.split("=")
					if pair.len() < 2 do return error("{kv}: want name=value")
					args[pair[0]] = value(pair[1..].join("="))
				}
				return self.perform(keymap.Binding.{ action = typed[0], args = Json.(args) }, keys.Key.{})
			},
			"pane.choose" => self.number()?,
			"pane.clock" => self.clock(),
			"pane.hints" => self.quick()?,
			"pane.find" => {
				query :: self.ask("find: ").lower()
				if query == "" do return false
				items, bids, lines := []string.{}, []string.{}, []string.{}
				wins :: self.view.windows or []
				loop win, i in wins; layer in win.layers; leaf in leaves(layer.layout or :null) {
					# TODO: a block too big for one reply is skipped, page with blob_read
					text :: self.tcall[Text](leaf.bid, "format", ["trim" = true, "unwrap" = true]) or continue
					loop line in text.content.split("\n") {
						if !line.lower().contains(query) do continue
						items << "{i + 1} {self.tab_name(wins[i])}: " + printable(line.trim())
						bids << leaf.bid
						lines << line.trim()
					}
				}
				if items.len() == 0 do return error("no match")
				i :: self.choose(title, items)
				if i < 0 do return false
				self.land = Copy.{ bid = bids[i], needle = lines[i], sel = query }
				self.focus(bids[i])?
				self.landed()
			},
			"client.palette" => return self.palette()?,
			"pane.pipe" => {
				if self.unpipe(self.bid) do return false
				self.pipe(self.bid, opts.command or return error("pane.pipe needs a command"))?
				self.draw()
			},
			"pane.run" => {
				cmd :: opts.command or return error("pane.run needs a command")
				discard os.sh("RX_PANE={quote(self.bid)} sh -c {quote(cmd)} </dev/null >/dev/null 2>&1 &")
			},
			"macro.record" => {
				if self.recording do self.macro = self.tape
				self.recording = !self.recording
				self.tape = ""
				self.draw()
			},
			"macro.play" => {
				if self.recording do return error("recording, can't replay")
				self.keys.unread = self.macro + self.keys.unread
				if self.macro == "" do return error("nothing recorded")
			},
			"pane.titles" => {
				self.frames = !self.frames
				self.fetch_status()
				self.relayout()?
			},
			"pane.dim" => {
				self.dim = !self.dim
				self.redraw()
			},
			"mouse.toggle" => {
				self.mouse_off = !self.mouse_off
				self.say(if self.mouse_off do "mouse off" else do "mouse on")
			},
			"layer.raise" => self.ok("session.raise_layer", ["layer_id" = self.floating()?])?,
			"layer.lower" => self.ok("session.lower_layer", ["layer_id" = self.floating()?])?,
			"layer.close" => self.ok("session.close_layer", ["layer_id" = self.floating()?])?,
			"layer.minimize" => self.ok("session.set_layer_state", ["layer_id" = self.floating()?, "state" = "minimized"])?,
			"layer.toggle_all" => {
				floats :: loop layer in self.win().layers { if layer.kind == "tiled" do continue; layer }
				if floats.len() == 0 do return error("no floating layer")
				shown :: floats.any({ ($.state or "") != "minimized" })
				state :: if shown do "minimized" else do "normal"
				loop layer in floats {
					self.ok("session.set_layer_state", ["layer_id" = layer.layer_id or "", "state" = state])?
				}
			},
			"layer.restore" => {
				id := ""
				loop layer in self.win().layers {
					if (layer.state or "") == "minimized" do id = layer.layer_id or ""
				}
				if id == "" do return error("no minimized pane")
				self.ok("session.set_layer_state", ["layer_id" = id, "state" = "normal", "focus" = true])?
			},
			"layer.new" => self.pop(opts.command or "")?,
			"layer.scratch" => self.scratch("scratch", self.view.windows or [], opts.opacity or 1.0)?,
			"layer.scratch_tab" => self.scratch("tab scratch", [self.win()], opts.opacity or 1.0)?,
			"pane.focus" => self.ok("session.focus_direction", ["direction" = dir, "wrap" = true])?,
			"pane.last" => self.focus(self.last_bid[self.wid] or return error("no last pane"))?,
			"pane.next" => self.ok("session.focus_next_pane", ["wrap" = true])?,
			"pane.attention" => {
				bids :: loop win in self.view.windows or []; layer in win.layers; leaf in leaves(layer.layout or :null) {
					leaf.bid
				}
				i :: bids.index(self.bid) or -1
				loop k in 1..=bids.len() {
					bid :: bids[(i + k) % bids.len()]
					if urgency(self.state(bid)) < 3 do continue
					self.focus(bid)?
					return false
				}
				return error("no program waiting")
			},
			"tab.new" => self.new_tab(opts.side or "", opts.command or "")?,
			"client.tab.goto" => {
				wins :: self.view.windows or []
				i :: opts.index or return error("client.tab.goto needs an index")
				at :: if i < 0 do wins.len() + i else do i - 1
				if at < 0 || at >= wins.len() do return error("no tab {i}")
				self.ok("session.focus_window", ["window_id" = wins[at].window_id])?
			},
			"tab.next" => self.ok("session.focus_next_window", ["wrap" = true])?,
			"tab.previous" => self.ok("session.focus_previous_window", ["wrap" = true])?,
			"tab.last" => {
				if self.last_wid == "" do return error("no last tab")
				self.ok("session.focus_window", ["window_id" = self.last_wid])?
			},
			"tab.move" => self.move_tab(dir == "left")?,
			"tab.close" => self.ok("session.close_window")?,
			"tab.even" => {
				layer :: self.layer_of(self.bid) or return error("no pane")
				loop split in evened(layer.layout or :null) do self.ratio(split, split.ratio)?
			},
			"pane.group" => {
				self.grouped = toggle(self.grouped, self.bid)
				self.draw()
			},
			"tab.sync" => {
				self.synced = toggle(self.synced, self.wid)
				self.redraw()
			},
			"tab.layout" => self.relayout_tab(opts.layout or "next")?,
			"tab.tile" => {
				name := opts.layout or "main-vertical"
				if name !in layouts do return error("no layout {name}")
				if (self.tiling[self.wid] or "") == name do name = ""
				tiling: [string]string = .[]
				loop layout, wid in self.tiling {
					if wid != self.wid do tiling[wid] = layout
				}
				if name != "" do tiling[self.wid] = name
				self.tiling = tiling
				self.tiled_as = .[]
				self.retile()?
				self.say(if name != "" do "tiling {name}" else do "tiling off")
			},
			"tab.rename" => self.rename_tab(self.view.active_window_id or "")?,
			"tab.choose" => {
				conn := rex.connect(self.sock)?
				defer conn.close()
				discard conn.call[Sessions]("session.attach_all", ["event_scope" = "session"])?
				items, sids, wids := []string.{}, []string.{}, []string.{}
				loop session in conn.call[Sessions]("session.list")?.sessions {
					wins :: (conn.call[View]("session.view", ["session_id" = session.session_id]) or continue).windows or []
					loop i in 0..wins.len() {
						items << "{session.label} {i + 1} {self.tab_name(wins[i])}"
						sids << session.session_id
						wids << wins[i].window_id
					}
				}
				previews: [string][]string
				sock :: self.sock
				look :: fn [mut previews, sock, sids, wids] (index: int) []string {
					if wids[index] !in previews do previews[wids[index]] = peek(sock, sids[index], wids[index]) or []
					previews[wids[index]] or []
				}
				i :: self.choose(title, items, look)
				if i < 0 do return false
				return self.act("session.select", Json.(["session_id" = sids[i], "window_id" = wids[i]]))
			},
			"client.mode.enter", "client.mode.exit", "client.mode.exit_all" => {
				if name == "client.mode.enter" {
					self.modes_on << (opts.name or return error("client.mode.enter needs a name"))
				}
				if name == "client.mode.exit" && self.modes_on.len() > 0 {
					self.modes_on = self.modes_on[..(self.modes_on.len() - 1)]
				}
				if name == "client.mode.exit_all" do self.modes_on = []
				self.redraw()
			},
		} else {
			return error("not_supported: rx has no action {name}")
		}

		false
	}

	pop :: fn(mut self; cmd: string) ! {
		opts: Obj = []
		if cmd != "" {
			opts["command"] = ["env", "RX_PANE=" + self.bid, "sh", "-c", cmd]
			opts["exit"] = ["quick_exit_threshold_ms" = 0.0]
		}
		self.ok("session.new_layer", ["bounds" = popup(), "layout" = rex.shell(self.here(), opts), "focus" = true])?
	}

	scratch :: fn(mut self; label: string, wins: []Window, opacity: float) ! {
		# can't index assign a field's map
		opacities := self.opacities
		opacities[label] = opacity
		self.opacities = opacities

		loop win in wins; layer in win.layers {
			blocks :: layer.blocks or []
			block :: blocks.find({ ($.label or "") == label }) or continue

			if win.window_id != self.wid {
				tiled :: leaves(self.win().layers[0].layout or :null)
				if tiled.len() == 0 do return error("no tiled pane")
				self.ok("session.move_block", ["block_id" = block.block_id, "anchor_block_id" = tiled[0].bid])?
				self.ok("session.float_block", ["block_id" = block.block_id, "bounds" = layer.bounds.map({ Json.($) })])?
				return self.focus(block.block_id)
			}
			shown :: (layer.state or "") != "minimized" && blocks.any({ $.block_id == self.bid })
			state :: if shown do "minimized" else do "normal"
			return self.ok("session.set_layer_state", [
				"layer_id" = layer.layer_id or "",
				"state" = state,
				"focus" = !shown,
			])
		}
		self.ok("session.new_layer", [
			"bounds" = popup(),
			"layout" = rex.shell(self.here(), label = label),
			"focus" = true,
		])?
	}

	# Rex keeps a tab open while it has a float.
	unstrand :: fn(mut self) ! {
		wins :: self.view.windows or []
		loop win, i in wins {
			if leaves(win.layers[0].layout or :null).len() > 0 do continue

			blocks: []Block = loop layer in win.layers; block in layer.blocks or [] do block
			if blocks.any({ ($.label or "") !in ["scratch", "tab scratch"] }) do continue

			# where closing it lands
			to :: wins[if i + 1 < wins.len() do i + 1 else do max(i - 1, 0)]
			loop layer in win.layers; block in layer.blocks or [] {
				if (block.label or "") != "scratch" || to.window_id == win.window_id do continue

				self.ok("session.move_block", ["block_id" = block.block_id, "anchor_block_id" = leaves(to.layers[0].layout or :null)[0].bid])?
				floated :: self.call[Floated]("session.float_block", ["block_id" = block.block_id, "bounds" = layer.bounds.map({ Json.($) })])?
				self.ok("session.set_layer_state", ["layer_id" = floated.layer_id or "", "state" = "minimized"])?
			}

			discard self.call[Ok]("session.close_window", ["window_id" = win.window_id]) or Ok.{}
		}
	}

	relayout_tab :: fn(mut self; name: string) ! {
		count :: layouts.len()
		i :: layouts.index(name) or match name {
			"next" => (self.layout + 1) % count,
			"previous" => (self.layout + count - 1) % count,
			_ => return error("no layout {name}"),
		}

		self.layout = i
		self.arrange(self.tiled(), layouts[i])?
		self.say(layouts[i])
	}

	rename_tab :: fn(mut self; wid: string) ! {
		label :: self.ask("rename tab: ")
		if label != "" do self.ok("session.set_window_label", ["window_id" = wid, "label" = label])?
	}

	new_tab :: fn(mut self; side, cmd: string) ! {
		tab :: self.call[NewWindow]("session.new_window", ["layout" = rex.shell(self.here(), runs(cmd))])?
		wins :: self.view.windows or []
		at := wins.len()
		active :: self.view.active_window_id or ""
		loop win, i in wins {
			if win.window_id == active do at = i + if side == "after" do 1 else do 0
		}
		if side != "" && at < wins.len() {
			self.ok("session.move_window", ["window_id" = tab.window_id, "before_window_id" = wins[at].window_id])?
		}
	}

	move_tab :: fn(mut self; left: bool) ! {
		active :: self.view.active_window_id or ""
		wins :: self.view.windows or []
		count :: wins.len()
		i := 0
		loop win, j in wins {
			if win.window_id == active do i = j
		}
		others: []Window = loop win in wins { if win.window_id == active do continue; win }
		at :: (i + count + if left do -1 else do 1) % count
		args: Obj = ["window_id" = active]
		if at < others.len() do args["before_window_id"] = others[at].window_id
		self.ok("session.move_window", args)?
	}

	here :: fn(mut self) string {
		rex.cwd(self.tcall[Process](self.bid, "process") or Process.{})
	}

	resize :: fn(mut self; dir: string, by: int) ! {
		across :: dir == "left" || dir == "right"
		layer :: self.layer_of(self.bid) or return error("no pane")
		if node := around(layer.layout or :null, self.bid, if across do "horizontal" else do "vertical") {
			split :: node.split or return error("no split")
			cells :: if across do float.(self.cols) * node.rect[2] else do float.(self.areas[0].h) * node.rect[3]
			step :: float.(by) / max(cells, 1.0) * if dir == "left" || dir == "up" do -1.0 else do 1.0
			self.ratio(split, clamp(split.ratio + step, 0.05, 0.95))?
		} else if layer.kind == "tiled" {
			return error("nothing to resize against")
		} else {
			self.ok("session.resize_layer", ["layer_id" = layer.layer_id or "", "bounds" = stretch(layer.bounds, dir, self.frac(dir, by))])?
		}
	}

	ratio :: fn(mut self; split: Split, to: float) ! {
		self.ok("session.resize_pane", [
			"direction" = split.direction, "ratio" = to,
			"before_block_id" = leaves(split.before)[0].bid, "after_block_id" = leaves(split.after)[0].bid,
		])?
	}

	frac :: fn(self; dir: string, by: int) float {
		float.(by) / float.(max(1, if dir == "left" || dir == "right" do self.cols else do self.areas[0].h))
	}

	floating :: fn(self) !string {
		layer :: self.layer_of(self.bid) or return error("no pane")
		if layer.kind == "tiled" do return error("not a floating layer")
		layer.layer_id or ""
	}

	beside :: fn(self; dir: string) ?Pane {
		focus :: self.focused() or return none
		across :: dir == "left" || dir == "right"
		loop pane in self.panes {
			if pane.layer != focus.layer || pane.bid == focus.bid do continue

			touches :: match dir {
				"left" => pane.x + pane.w + 1 == focus.x,
				"right" => focus.x + focus.w + 1 == pane.x,
				"up" => pane.y + pane.h + 1 == focus.y,
				_ => focus.y + focus.h + 1 == pane.y,
			}

			overlaps :: if across {
				pane.y < focus.y + focus.h && focus.y < pane.y + pane.h
			} else {
				pane.x < focus.x + focus.w && focus.x < pane.x + pane.w
			}
			if touches && overlaps do return pane
		}
		none
	}

	float :: fn(mut self) ! {
		layer :: self.layer_of(self.bid) or return error("no pane")
		if layer.kind == "tiled" {
			return self.ok("session.float_block", ["block_id" = self.bid, "bounds" = popup()])
		}
		tiled :: leaves(self.win().layers[0].layout or :null)
		if tiled.len() == 0 do return error("no tiled pane")
		self.ok("session.move_block", ["block_id" = self.bid, "anchor_block_id" = tiled[0].bid])?
	}

	requested :: fn(mut self; body: Body) !bool {
		reply: Obj = ["call_id" = body.call_id or ""]
		name :: body.action or ""
		detach :: self.act(name, body.args) or {
			reply["error"] = ["code" = if name in self.ours do "internal" else do "not_supported", "message" = $.message()]
			false
		}
		if "error" !in reply do reply["result"] = :null
		discard self.conn.call[Ok]("client.reply", reply)?
		if !detach && self.keys.unread != "" do return self.input("")
		detach
	}

	load_keymap :: fn(mut self) ! {
		km :: self.conn.call[keymap.Keymap]("client.keymap", keymap.request()?)?
		self.km = km
		self.can = keymap.can(km)?
		self.ours = keymap.ours()?
		self.hash = km.config.hash
		self.typed = []
		titles: [string]string = .[]
		arg_words: [string][]string = .[]
		all := keymap.declared()?
		loop action in km.actions or [] do all << action
		loop action in all {
			titles[action.name] = action.title or action.name
			arg_words[action.name] = keymap.arg_words(action)
		}
		self.titles = titles
		self.arg_words = arg_words
		self.peers = (self.others() or []).len()
	}

	own :: fn(mut self) {
		if self.readonly do return
		ids: []Json = loop pane in self.panes do Json.(pane.bid)
		self.ok("session.own_block", ["block_ids" = ids]) or return
		loop pane in self.panes {
			self.term(pane.bid, "resize", ["columns" = float.(pane.w), "rows" = float.(pane.h)]) or return
		}
		self.owned = true
	}

	write :: fn(mut self; data: string) ! {
		if data == "" do return ()
		if pane := self.focused(), pane.painted && pane.term.scroll(0) do self.redraw()
		# TODO: synced panes get mouse reports meant for the focused one
		if self.bid in self.grouped {
			loop bid in self.grouped do self.term(bid, "write", ["data" = data]) or {}
			return ()
		}
		if self.wid in self.synced {
			loop pane in self.panes do self.term(pane.bid, "write", ["data" = data])?
			return ()
		}
		self.term(self.bid, "write", ["data" = data])?
	}

	focus :: fn(mut self; bid: string) ! {
		self.ok("session.focus_block", ["block_id" = bid])?
	}

	term :: fn(mut self; bid, method: string, args: Obj) ! {
		if self.readonly do return ()
		discard self.tcall[Ok](bid, method, args)?
	}

	tcall[T] :: fn(mut self; bid, method: string, args: Obj = []) !T {
		self.call[T]("com.superlogical.terminal." + method, ["block_id" = bid, "args" = args])
	}

	ok :: fn(mut self; method: string, payload: Obj = []) ! {
		discard self.call[Ok](method, payload)?
	}

	call[T] :: fn(mut self; method: string, payload: Obj = []) !T {
		body := payload
		body["session_id"] = self.sid
		self.conn.call[T](method, body)
	}
}

setlocale : fn(category: i32, name: cstr) ptr : foreign
wcwidth : fn(c: i32) i32 : foreign

# TODO: libc's widths, emoji can differ from the outer terminal's
cells :: fn(text: string) width: int {
	esc := false
	loop char in text.runes() {
		esc = esc || char == '\e'
		if !esc {
			width += max(unsafe wcwidth(i32.(char)), 0)
		}
		esc = esc && char != 'm'
	}
	return
}
describe :: fn(peer: Peer) string {
	info :: peer.info or Info.{}
	line := peer.principal.display + "  " + (info.label or info.name or "?") + " " + (info.version or "")
	if (peer.connection_state or "") == "lost" do line += "  (lost)"
	line
}

big :: fn(text: string) []string {
	glyphs :: ["####.##.##.####", "..#..#..#..#..#", "###..#####..###", "###..####..####", "#.##.####..#..#",
		"####..###..####", "####..####.####", "###..#..#..#..#", "####.#####.####", "####.####..####"]
	loop line in 0..5 {
		row := ""
		loop i in 0..text.len() {
			if i > 0 do row += "  "
			glyph :: if text[i] == ':' {
				".#.#."[line..(line + 1)]
			} else {
				glyphs[int.(text[i] - '0')][(line * 3)..(line * 3 + 3)]
			}
			loop col in 0..glyph.len() do row += if glyph[col] == '#' do "██" else do "  "
		}
		row
	}
}

fit :: fn(text: string, width: int) string {
	out := ""
	used, esc := 0, false
	loop char in text.runes() {
		esc = esc || char == '\e'
		if !esc {
			used += cells(char.str())
		}
		if used > width do break
		out += char.str()
		esc = esc && char != 'm'
	}
	out
}

accent :: fn(text: string, at: []int) out: string {
	on := false
	loop j in ..text.len() {
		if text[j] & 0xC0 != 0x80 && (j in at) != on {
			on = !on
			out += if on do "\e[1;4m" else do "\e[22;24m"
		}
		out += text[j..(j + 1)]
	}
	if on do out + "\e[22;24m" else do out
}

cut :: fn(text: string, width: int) string {
	if cells(text) > width do fit(text, width - 1) + "…" else do text
}

pad :: fn(text: string, width: int) string {
	text := fit(text, width)
	loop cells(text)..width do text += " "
	text
}

legend :: fn(pairs: [](string, string), width: int) []string {
	out := []string.{}
	line := ""
	loop (key, what) in pairs {
		entry :: "{key} {what}"
		if line != "" && cells(line) + 2 + cells(entry) > width {
			out << line
			line = ""
		}
		line += (if line == "" do "" else do "  ") + entry
	}
	if line != "" do out << line
	out
}

box :: fn(x, y, w: int, title: string, rows: []string, on := -1, head: []string = [], foot: []string = []) string {
	rule :: fn(left, right: string) string {
		line := left
		loop 0..w do line += "─"
		line + right
	}
	frame := "\e[0m\e[{y + 1};{x + 1}H" + rule("┌", "┐")
	if title != "" do frame += "\e[{y + 1};{x + 3}H\e[1m " + fit(title, w - 4) + " \e[22m"
	row := y + 1
	parts :: [head, rows, foot]
	loop k in 0..3 {
		if parts[k].len() == 0 do continue
		if row > y + 1 {
			frame += "\e[{row + 1};{x + 1}H" + rule("├", "┤")
			row += 1
		}
		loop i in 0..parts[k].len() {
			picked :: if k == 1 && i == on do "\e[30;42m" else do ""
			frame += "\e[{row + 1};{x + 1}H│" + picked + " " + pad(parts[k][i], w - 2) + " \e[0m│"
			row += 1
		}
	}
	frame + "\e[{row + 1};{x + 1}H" + rule("└", "┘")
}
