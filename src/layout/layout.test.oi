use json
use json.{ Json }

test! "layouts" {
	show :: fn(bids: []string, name: string) string {
		(loop step in arrange(bids, name) do "{step.bid}>{step.anchor} {step.direction[..1]} {step.ratio}").join(", ")
	}
	assert! show(["a", "b", "c"], "main-horizontal") == "b>a v 0.7, c>b h 0.5"
	assert! show(["a", "b", "c", "d", "e"], "tiled") == "d>a v 0.5, b>a h 0.3333333333333333, c>b h 0.5, e>d h 0.5"
	assert! (loop (from, to) in rotation(["a", "b", "c"], false) do from + to).join(" ") == "cb ca"
	# a | (b over c) | d
	tree :: json.parse(r"""{"rect": [0, 0, 1, 1], "split": {"direction": "horizontal", "ratio": 0.2,
		"before": {"rect": [0, 0, 0.2, 1], "block_id": "a"},
		"after": {"rect": [0.2, 0, 0.8, 1], "split": {"direction": "horizontal", "ratio": 0.9,
			"before": {"rect": [0.2, 0, 0.7, 1], "split": {"direction": "vertical", "ratio": 0.1,
				"before": {"rect": [0.2, 0, 0.7, 0.1], "block_id": "b"}, "after": {"rect": [0.2, 0.1, 0.7, 0.9], "block_id": "c"}}},
			"after": {"rect": [0.9, 0, 0.1, 1], "block_id": "d"}}}}}""") or panic!($.message())
	assert! (loop split in evened(tree) do "{split.direction[..1]} {split.ratio}").join(", ") == "h 0.3333333333333333, h 0.5, v 0.5"
}

test! "stretch and shift" {
	bounds :: [0.5, 0.25, 0.5, 0.5]
	show :: fn(value: json.Arr) string { Json.(value).str() }
	assert! show(stretch(bounds, "right", 0.25)) == "[0.75,0.25,0.25,0.5]" && show(stretch(bounds, "up", 0.5)) == "[0.5,0,0.5,0.75]"
	assert! show(shift(bounds, "left", 0.75)) == "[0,0.25,0.5,0.5]" && show(stretch([0.0, 0.0, 0.125, 1.0], "left", 0.125)) == "[0,0,0.125,1]"
}
