use json.{ Obj }

pub Key :: struct {
	pub ev: Obj
	pub names: []string
	pub code: string
	pub action: string
	pub text: string
}

pub csi :: fn(seq: string) (params: string, fin: u8, len: int) {
	if !seq.starts_with("\e[") do return
	i := 2
	loop i < seq.len() && seq[i] >= ' ' && seq[i] <= '?' do i += 1
	if i < seq.len() do params, fin, len = seq[2..i], seq[i], i + 1
	return
}

# shifted US punctuation, each followed by its unshifted key
shifted :: "~`!1@2#3$4%5^6&7*8(9)0_-+={{[}}]|\\:;\"'<,>.?/"

# TODO: US layout only. an ESC and a key in one read is alt
pub key_of :: fn(buf: string) (?Key, int) {
	alt :: buf.len() > 1 && buf[0] == '\e' && buf[1] != '[' && buf[1] != 'O' && buf[1] != '\e'
	skip :: if alt do 1 else do 0
	seq :: buf[skip..]
	code := int.(seq[0])
	mods := if alt do 2 else do 0 # kitty bits
	action := "press"
	used := 1
	key, base := "", ""
	params, fin, len := csi(seq)
	if seq.starts_with("\eO") && seq.len() > 2 do params, fin, len = "", seq[2], 3
	if len > 0 {
		fields :: params.split(";")
		used = len
		if fields.len() > 1 {
			parts :: fields[1].split(":")
			mods |= (int.try_from(parts[0]) or 1) - 1
			if parts.len() > 1 {
				action = match parts[1] { "2" => "repeat", "3" => "release" } else do "press"
			}
		}
		if fin == 'u' && params != "" && params[0] <= '9' {
			code = int.try_from(fields[0].split(":")[0]) or 0
		} else {
			specials :: ["A" = ("arrow_up", "up"), "B" = ("arrow_down", "down"), "C" = ("arrow_right", "right"), "D" = ("arrow_left", "left"),
				"H" = ("home", "home"), "F" = ("end", "end"), "Z" = ("tab", "tab"), "1" = ("home", "home"), "4" = ("end", "end"),
				"2" = ("insert", "insert"), "3" = ("delete", "delete"), "5" = ("page_up", "pageup"), "6" = ("page_down", "pagedown"),
				"P" = ("f1", "f1"), "Q" = ("f2", "f2"), "R" = ("f3", "f3"), "S" = ("f4", "f4"), "11" = ("f1", "f1"), "12" = ("f2", "f2"),
				"13" = ("f3", "f3"), "14" = ("f4", "f4"), "15" = ("f5", "f5"), "17" = ("f6", "f6"), "18" = ("f7", "f7"), "19" = ("f8", "f8"),
				"20" = ("f9", "f9"), "21" = ("f10", "f10"), "23" = ("f11", "f11"), "24" = ("f12", "f12")]
			key, base = specials[if fin == '~' do fields[0] else do rune.(fin).str()] or return (none, used + skip)
			code = if fin == 'Z' do 9 else do 0
			if fin == 'Z' do mods |= 1
		}
	} else if code == 0 {
		mods |= 4
		code = 32
	} else if code < 27 && code != '\t' && code != '\r' {
		mods |= 4
		code += 96
	}
	used += skip
	if code >= 57344 {
		key, base, code = private(code)
		if key == "" do return (none, used)
	}

	text :: rune.(code).str()
	if key == "" {
		if code >= 'A' && code <= 'Z' do code, mods = code + 32, mods | 1
		i :: shifted.split(text)[0].len()
		if i % 2 == 0 && i < shifted.len() do code, mods = int.(shifted[i + 1]), mods | 1
		names :: ['`' = "backquote", '-' = "minus", '=' = "equal", '[' = "bracket_left", ']' = "bracket_right",
			'\\' = "backslash", ';' = "semicolon", '\'' = "quote", ',' = "comma", '.' = "period", '/' = "slash",
			' ' = "space", '\r' = "enter", '\t' = "tab", '\e' = "escape", '\x7f' = "backspace"]

		key = match {
			code >= 'a' && code <= 'z' => "key_" + rune.(code).str(),
			code >= '0' && code <= '9' => "digit_" + rune.(code).str(),
		} else {
			names[rune.(code)] or ""
		}
		if key == "" do return (none, used)

		base = match key {
			"space", "enter", "tab", "backspace" => key,
			"escape" => "esc",
		} else do rune.(code).str()
	}

	ev: Obj = ["key" = key, "unshifted_codepoint" = float.(code), "text" = "", "consumed_mods" = "", "composing" = false, "action" = action]
	typed :: mods & !1 == 0 && code >= ' ' && code < 0x7f
	if typed {
		ev["text"] = text
		if mods == 1 do ev["consumed_mods"] = "shift"
	}
	ev["mods"] = spell(mods, [(1, "shift"), (4, "ctrl"), (2, "alt"), (8, "super")]).join("+")
	held := spell(mods, [(4, "ctrl"), (2, "alt"), (1, "shift"), (8, "cmd")]).join("+")
	if held != "" do held += "+"
	names := [held + base, held + "[" + w3c(key) + "]"]
	# shifted punctuation is also bound by what it types, such as %
	if typed && mods == 1 && !(code >= 'a' && code <= 'z') do names << text
	(Key.{ ev = ev, names = names, code = key, action = action, text = if typed do text else do "" }, used)
}

private :: fn(code: int) (string, string, int) {
	if code >= 57376 && code <= 57388 do return ("f{code - 57363}", "f{code - 57363}", 0)
	if code >= 57399 && code <= 57408 {
		return ("numpad_{code - 57399}", "{code - 57399}", '0' + code - 57399)
	}
	keypad :: [57409 = ("decimal", "."), 57410 = ("divide", "/"), 57411 = ("multiply", "*"), 57412 = ("subtract", "-"), 57413 = ("add", "+"),
		57414 = ("enter", "enter"), 57415 = ("equal", "="), 57416 = ("separator", ","), 57417 = ("left", "left"), 57418 = ("right", "right"),
		57419 = ("up", "up"), 57420 = ("down", "down"), 57421 = ("page_up", "pageup"), 57422 = ("page_down", "pagedown"),
		57423 = ("home", "home"), 57424 = ("end", "end"), 57425 = ("insert", "insert"), 57426 = ("delete", "delete")]
	key, base :: keypad[code] or return ("", "", 0)
	(
		"numpad_{key}",
		base,
		match {
			base.len() == 1 => int.(base[0]),
			key == "enter" => 13,
		} else do 0
	)
}

w3c :: fn(key: string) string {
	(loop word in key.split("_") do word[..1].upper() + word[1..]).join("")
}

spell :: fn(mods: int, order: [](int, string)) []string {
	loop (bit, name) in order { if mods & bit == 0 do continue; name }
}
